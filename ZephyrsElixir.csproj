<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <Version>0.7.0</Version>
    <AssemblyVersion>0.7.0.0</AssemblyVersion>
    <FileVersion>0.7.0</FileVersion>
    <ApplicationIcon>Assets/Icons/icon.ico</ApplicationIcon>
<ApplicationManifest>app.manifest</ApplicationManifest>
<Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
<ImplicitUsings>disable</ImplicitUsings>
<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Emoji.Wpf" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="SharpVectors.Wpf" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Images\batteryguru.png" />
    <Resource Include="Assets\Images\github.png" />
    <Resource Include="Assets\Images\logo.png" />
    <Resource Include="Assets\Images\mascotte.png" />
    <Resource Include="Assets\Images\telegram.png" />
    <Resource Include="Assets\Images\Wizardslogo.bmp" />
    <Resource Include="Assets\Images\WizardSmallslogo.bmp" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Tools\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Icons\*.svg" />
  </ItemGroup>
</Project>