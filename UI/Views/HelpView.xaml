                                </TextBlock>
                                <TextBlock Style="{StaticResource Body}" Text="{Binding [Help_FirstSteps_AllSet_Body], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                            </StackPanel>
