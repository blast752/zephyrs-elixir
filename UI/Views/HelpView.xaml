                        </Border>

                        <TextBlock Style="{StaticResource H2}" Text="{Binding [Help_Basics_Interface_Title], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>

                        <TextBlock Style="{StaticResource H3}">
                            <Run Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets"/><Run Text="  "/><Run Text="{Binding [Help_Basics_Sidebar_Title], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Body}" Text="{Binding [Help_Basics_Sidebar_Body], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>

                        <Border Style="{StaticResource HighlightBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,6" Text="{Binding [Help_Basics_Sidebar_Home], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,6" Text="{Binding [Help_Basics_Sidebar_Optimize], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
