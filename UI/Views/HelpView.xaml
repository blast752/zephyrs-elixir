                        </TextBlock>
                        <TextBlock Style="{StaticResource Body}" Text="{Binding [Help_Basics_Console_Body], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>

                        <helpers:ShadowCard Style="{StaticResource HintBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Foreground="White">
                                    <Run Text="&#xE946;" FontFamily="Segoe MDL2 Assets"/><Run Text="  "/><Run Text="{Binding [Help_Basics_Console_Tip_Title], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Body}" Text="{Binding [Help_Basics_Console_Tip_Body], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                            </StackPanel>
                        </helpers:ShadowCard>

                        <TextBlock Style="{StaticResource H2}" Text="{Binding [Help_Basics_HowOpt_Title], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource Body}" Text="{Binding [Help_Basics_HowOpt_Body], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>

                        <Border Style="{StaticResource HighlightBox}">
