                        <Border Style="{StaticResource HighlightBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,4" Text="{Binding [Help_FirstSteps_Popup1], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,4" Text="{Binding [Help_FirstSteps_Popup2], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                                <TextBlock Style="{StaticResource Body}" Text="{Binding [Help_FirstSteps_Popup3], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource H2}" Text="{Binding [Help_FirstSteps_Verify_Title], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource Body}" Text="{Binding [Help_FirstSteps_Verify_Body], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>

                        <Border Style="{StaticResource HighlightBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,4" Text="{Binding [Help_FirstSteps_Verify1], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                                <TextBlock Style="{StaticResource Body}" Text="{Binding [Help_FirstSteps_Verify2], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Body}" Margin="0,12,0,0" Text="{Binding [Help_FirstSteps_VerifyHint], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>

                        <TextBlock Style="{StaticResource H2}" Text="{Binding [Help_FirstSteps_Wireless_Title], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource Body}" Text="{Binding [Help_FirstSteps_Wireless_Body], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>

                        <Border Style="{StaticResource HighlightBox}">
