                                <TextBlock Style="{StaticResource Body}" Text="{Binding [Help_Trouble_DNS_Body], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HighlightBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H3}" Text="{Binding [Help_Trouble_AnimSlider_Title], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                                <TextBlock Style="{StaticResource Body}" Text="{Binding [Help_Trouble_AnimSlider_Body], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource H2}" Text="{Binding [Help_Trouble_General_Title], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>

                        <helpers:ShadowCard Style="{StaticResource HintBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Foreground="White">
                                    <Run Text="&#xE946;" FontFamily="Segoe MDL2 Assets"/><Run Text="  "/><Run Text="{Binding [Help_Trouble_ExportLogs_Title], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Body}" Text="{Binding [Help_Trouble_ExportLogs_Body], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                            </StackPanel>
                        </helpers:ShadowCard>

                        <Border Style="{StaticResource HighlightBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H3}" Text="{Binding [Help_Trouble_Reset_Title], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                                <TextBlock Style="{StaticResource Body}" Text="{Binding [Help_Trouble_Reset_Body], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                            </StackPanel>
                        </Border>

                        <helpers:ShadowCard Style="{StaticResource HintBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Foreground="White">
                                    <Run Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets"/><Run Text="  "/><Run Text="{Binding [Help_Trouble_StillNeed_Title], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Body}" Text="{Binding [Help_Trouble_StillNeed_Body], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                            </StackPanel>
                        </helpers:ShadowCard>
                    </StackPanel>
                </helpers:ShadowCard>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="PageTemplate_Tips">
            <StackPanel Style="{StaticResource SlideFadeOnVisible}">
                <helpers:ShadowCard Style="{StaticResource CardContainer}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H1}" Text="{Binding [Help_Tips_Title], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource BodyLarge}" Margin="0,10,0,0" Text="{Binding [Help_Tips_Intro], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>

                        <ItemsControl ItemsSource="{Binding DataContext.Tips, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,20,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource HighlightBox}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <helpers:GlowIcon Size="32" CornerRadius="16" HorizontalAlignment="Left"
                                                       Background="{StaticResource AccentGradientBrush}"
                                                       GlowEffect="{StaticResource SoftGlow}">
                                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="16" 
                                                              Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </helpers:GlowIcon>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" 
                                                          Margin="42,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Body}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <helpers:ShadowCard Style="{StaticResource HintBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Foreground="White">
                                    <Run Text="&#xEA80;" FontFamily="Segoe MDL2 Assets"/><Run Text="  "/><Run Text="{Binding [Help_Tips_Shortcut_Title], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0" Text="{Binding [Help_Tips_Shortcut_Body], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                            </StackPanel>
                        </helpers:ShadowCard>
                    </StackPanel>
                </helpers:ShadowCard>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="PageTemplate_Faq">
            <StackPanel Style="{StaticResource SlideFadeOnVisible}">
                <helpers:ShadowCard Style="{StaticResource CardContainer}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H1}" Text="{Binding [Help_Faq_Title], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource BodyLarge}" Margin="0,10,0,0" Text="{Binding [Help_Faq_Intro], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>

                        <TextBox Style="{StaticResource App.Style.TextBox.Glass}"
                                 Tag="{Binding [Help_Faq_SearchPlaceholder], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"
                                 Text="{Binding DataContext.SearchQuery, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,20,0,16"
                                 Height="42"
                                 FontSize="14"/>

                        <ItemsControl ItemsSource="{Binding DataContext.FilteredFaqView, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource HighlightBox}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource H3}">
                                                <Run Text="&#xE11B;" FontFamily="Segoe MDL2 Assets"/><Run Text="  "/>
                                                <Run Text="{Binding Question}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Answer}" Style="{StaticResource Body}" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </helpers:ShadowCard>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="PageTemplate_About">
            <StackPanel Style="{StaticResource SlideFadeOnVisible}">
                <helpers:ShadowCard Style="{StaticResource CardContainer}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H1}" Text="{Binding [Help_About_Title], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource BodyLarge}" Margin="0,10,0,0" Text="{Binding [Help_About_Intro], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>

                        <TextBlock Style="{StaticResource H2}" Text="{Binding [Help_About_Story_Title], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource Body}" Text="{Binding [Help_About_Story1], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource Body}" Text="{Binding [Help_About_Story2], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>

                        <Border Style="{StaticResource HighlightBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H3}">
                                    <Run Text="&#xE946;" FontFamily="Segoe MDL2 Assets"/><Run Text="  "/><Run Text="{Binding [Help_About_Tech_Title], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Body}" Margin="0,8,0,4" Text="{Binding [Help_About_Tech_BuiltWith], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,4" Text="{Binding [Help_About_Tech_Architecture], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,4" Text="{Binding [Help_About_Tech_UI], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                                <TextBlock Style="{StaticResource Body}" Text="{Binding [Help_About_Tech_Backend], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource H2}" Text="{Binding [Help_About_Philosophy_Title], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource Body}" Text="{Binding [Help_About_Philosophy_Intro], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>

                        <Border Style="{StaticResource HighlightBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,8" Text="{Binding [Help_About_Phil_Transparent], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,8" Text="{Binding [Help_About_Phil_Respectful], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,8" Text="{Binding [Help_About_Phil_Beautiful], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                                <TextBlock Style="{StaticResource Body}" Text="{Binding [Help_About_Phil_Empowering], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource H2}" Text="{Binding [Help_About_OpenSource_Title], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource Body}" Text="{Binding [Help_About_OpenSource_Body], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>

                        <Border Style="{StaticResource HighlightBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Body}">
                                    <Run Text="Website: "/>
                                    <Hyperlink NavigateUri="https://www.zephyrselixir.com" 
                                             helpers:HyperlinkExtensions.OpenInBrowser="True">
                                        www.zephyrselixir.com
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Body}">
                                    <Run Text="GitHub: "/>
                                    <Hyperlink NavigateUri="https://github.com/zephyrs-elixir" 
                                             helpers:HyperlinkExtensions.OpenInBrowser="True">
                                        github.com/zephyrs-elixir
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource H2}" Text="{Binding [Help_About_License_Title], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource Body}" Text="{Binding [Help_About_License_Body], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>

                        <helpers:ShadowCard Style="{StaticResource HintBox}" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Body}" 
                                         TextAlignment="Center"
                                         FontSize="16"
                                         Margin="0,0,0,8">
                                    <Run FontWeight="SemiBold" Foreground="White" Text="{Binding [Help_About_MadeWith], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Caption}" TextAlignment="Center" Text="{Binding [Help_About_Copyright], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                            </StackPanel>
                        </helpers:ShadowCard>
                    </StackPanel>
                </helpers:ShadowCard>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#14234359" Offset="0.0"/>
                <GradientStop Color="#193C5A8E" Offset="0.5"/>
                <GradientStop Color="#1428476B" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" 
                    Grid.Column="0" 
                    Grid.ColumnSpan="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,35,0,45">
            <Grid VerticalAlignment="Center">
                <TextBlock Text="&#xE897;" 
                         FontFamily="Segoe MDL2 Assets" 
                         FontSize="36" 
                         Foreground="White" 
                         Effect="{StaticResource GlowEffect}" 
                         IsHitTestVisible="False"/>
                <TextBlock Text="&#xE897;" 
                         FontFamily="Segoe MDL2 Assets" 
                         FontSize="36" 
                         Foreground="White"/>
            </Grid>
            <TextBlock Margin="14,0,0,0" 
                     Style="{StaticResource H1}" 
                     FontSize="50" 
                     VerticalAlignment="Center"
                     Text="{Binding [Help_PageTitle], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" 
                    Grid.Column="0" 
                    Margin="24,0,20,24">
            <helpers:ShadowCard Style="{StaticResource CardContainer}" 
                    Padding="10">
                <ListBox ItemsSource="{Binding NavItems}" 
                         SelectedItem="{Binding SelectedNav}" 
                         Style="{StaticResource NavListBox}"/>
            </helpers:ShadowCard>

            <Border CornerRadius="14" 
                    Background="#1EFFFFFF" 
                    Padding="14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="&#xE946;" 
                                 FontFamily="Segoe MDL2 Assets" 
                                 FontSize="14"
                                 Foreground="#FFD700"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"/>
                        <TextBlock FontSize="13"
                                 FontWeight="SemiBold"
                                 Foreground="White"
                                 VerticalAlignment="Center"
                                 Text="{Binding [Help_QuickTip_Title], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding [Help_QuickTip_Body], Source={x:Static loc:TranslationManager.Instance}, Mode=OneWay}"/>
                </StackPanel>
            </Border>
        </StackPanel>
        
        <ScrollViewer Grid.Row="1" 
                      Grid.Column="1" 
                      VerticalScrollBarVisibility="Auto" 
                      Padding="10,0,30,24">
            
            <ContentControl Content="{Binding SelectedNav}" Margin="10,0,30,0">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource PageTemplate_Welcome}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedNav.Key}" Value="welcome">
                                <Setter Property="ContentTemplate" Value="{StaticResource PageTemplate_Welcome}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedNav.Key}" Value="first-steps">
                                <Setter Property="ContentTemplate" Value="{StaticResource PageTemplate_FirstSteps}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedNav.Key}" Value="basics">
                                <Setter Property="ContentTemplate" Value="{StaticResource PageTemplate_Basics}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedNav.Key}" Value="quick-guide">
                                <Setter Property="ContentTemplate" Value="{StaticResource PageTemplate_QuickGuide}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedNav.Key}" Value="complete-guide">
                                <Setter Property="ContentTemplate" Value="{StaticResource PageTemplate_CompleteGuide}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedNav.Key}" Value="troubleshooting">
                                <Setter Property="ContentTemplate" Value="{StaticResource PageTemplate_Troubleshooting}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedNav.Key}" Value="tips">
                                <Setter Property="ContentTemplate" Value="{StaticResource PageTemplate_Tips}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedNav.Key}" Value="faq">
                                <Setter Property="ContentTemplate" Value="{StaticResource PageTemplate_Faq}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedNav.Key}" Value="about">
                                <Setter Property="ContentTemplate" Value="{StaticResource PageTemplate_About}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            
        </ScrollViewer>
    </Grid>
</UserControl>
