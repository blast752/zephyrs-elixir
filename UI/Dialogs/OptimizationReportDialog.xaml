<Window x:Class="ZephyrsElixir.UI.Dialogs.OptimizationReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:ZephyrsElixir.UI.Helpers"
        Title="{h:Translate Report_Title}" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        Width="520" SizeToContent="Height">

    <Window.Resources>
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootContainer"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.35"
                             EasingFunction="{StaticResource App.Easing.Smooth}"/>
            <DoubleAnimation Storyboard.TargetName="RootTransform"
                             Storyboard.TargetProperty="Y"
                             From="24" To="0" Duration="0:0:0.35"
                             EasingFunction="{StaticResource App.Easing.Bounce}"/>
        </Storyboard>

        <Storyboard x:Key="IconPulse" RepeatBehavior="1x">
            <DoubleAnimation Storyboard.TargetName="IconGlowEffect"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="0.8" Duration="0:0:0.5"
                             AutoReverse="True"
                             EasingFunction="{StaticResource App.Easing.Smooth}"/>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="IconScale"
                                           Storyboard.TargetProperty="ScaleX">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1.08" EasingFunction="{StaticResource App.Easing.Bounce}"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1.0" EasingFunction="{StaticResource App.Easing.Smooth}"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="IconScale"
                                           Storyboard.TargetProperty="ScaleY">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1.08" EasingFunction="{StaticResource App.Easing.Bounce}"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1.0" EasingFunction="{StaticResource App.Easing.Smooth}"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SectionIconCircle" TargetType="Border">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="SectionDetail" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#90A0B8"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <Style x:Key="SectionValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInStoryboard}"/>
            <BeginStoryboard Storyboard="{StaticResource IconPulse}"/>
        </EventTrigger>
    </Window.Triggers>

    <Grid x:Name="RootContainer" Margin="20" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootTransform" Y="24"/>
        </Grid.RenderTransform>

        <Border Background="Black" CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Color="Black" Opacity="0.5"/>
            </Border.Effect>
        </Border>

        <Border Background="{StaticResource App.Brush.TitleBarBg}" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="16" ClipToBounds="True" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Grid HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Border x:Name="IconGlow" Width="76" Height="76" CornerRadius="38" Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect x:Name="IconGlowEffect" BlurRadius="28" ShadowDepth="0" Opacity="0"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="IconCircle" Width="76" Height="76" CornerRadius="38"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="IconScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <h:Icon x:Name="HeaderIcon" Size="38" Foreground="White"/>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="HeaderTitle" FontSize="22" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" TextAlignment="Center"/>

                    <TextBlock x:Name="HeaderSubtitle" FontSize="13" Foreground="#80A0B8"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="380"/>
                </StackPanel>

                <Border Grid.Row="1" CornerRadius="12" Background="#10FFFFFF"
                        BorderBrush="#1AFFFFFF" BorderThickness="1"
                        Padding="20,14" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{h:Translate Report_TotalFreed}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#607888" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TotalFreed" Text="0 MB" FontSize="22" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,2,0,0">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFD700" Offset="0"/>
                                        <GradientStop Color="#FFA500" Offset="1"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </StackPanel>

                        <Border Grid.Column="1" Width="1" Background="#1AFFFFFF" Margin="16,2"/>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="{h:Translate Report_StepsDone}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#607888" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="StepsCompleted" Text="0 / 7" FontSize="22" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" MaxHeight="340" VerticalScrollBarVisibility="Auto"
                              Margin="0,0,0,4">
                    <StackPanel x:Name="SectionsPanel">

                        <Border x:Name="MemorySection" Visibility="Collapsed"
                                Style="{StaticResource SectionCard}" Background="#0C007FFF">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource SectionIconCircle}" Background="#1C007FFF">
                                    <h:Icon Kind="touch" Size="19" Foreground="{StaticResource App.Brush.DeepSkyBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{h:Translate Report_Memory_Title}" Style="{StaticResource SectionTitle}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{h:Translate Report_Memory_RamFreed}" Style="{StaticResource SectionDetail}"/>
                                        <TextBlock x:Name="MemoryFreed" Text="0 MB"
                                                   Style="{StaticResource SectionValue}" Foreground="#64D6FF" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel x:Name="AppsPanel" Visibility="Collapsed" Margin="0,4,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="2" Style="{StaticResource StatusBadge}"
                                        Background="#1800BFFF" VerticalAlignment="Top">
                                    <TextBlock x:Name="AppsKilledCount" Text="0 apps" FontSize="11"
                                               FontWeight="SemiBold" Foreground="#64D6FF"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border x:Name="StorageSection" Visibility="Collapsed"
                                Style="{StaticResource SectionCard}" Background="#0CFFD700">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource SectionIconCircle}" Background="#1CFFD700">
                                    <h:Icon Kind="ram" Size="19" Foreground="#FFD700" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{h:Translate Report_Storage_Title}" Style="{StaticResource SectionTitle}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{h:Translate Report_Storage_SpaceFreed}" Style="{StaticResource SectionDetail}"/>
                                        <TextBlock x:Name="StorageFreed" Text="0 MB"
                                                   Style="{StaticResource SectionValue}" Foreground="#FFE066" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel x:Name="CleanedPanel" Visibility="Collapsed" Margin="0,4,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{h:Translate Report_Storage_Trim}" Style="{StaticResource SectionDetail}" Margin="0"/>
                                        <TextBlock x:Name="TrimStatus" Text="—"
                                                   Style="{StaticResource SectionValue}" Margin="0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="NetworkSection" Visibility="Collapsed"
                                Style="{StaticResource SectionCard}" Background="#0C00E676">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource SectionIconCircle}" Background="#1C00E676">
                                    <h:Icon Kind="wireless" Size="19" Foreground="#00E676" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{h:Translate Report_Network_Title}" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{h:Translate Report_Network_ScansDisabled}" FontSize="12"
                                               Foreground="#80E8B0" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="CompilationSection" Visibility="Collapsed"
                                Style="{StaticResource SectionCard}" Background="#0CA855F7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource SectionIconCircle}" Background="#1CA855F7">
                                    <h:Icon Kind="braces" Size="19" Foreground="#A855F7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{h:Translate Report_Compilation_Title}" Style="{StaticResource SectionTitle}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{h:Translate Report_Compilation_Mode}" Style="{StaticResource SectionDetail}" Margin="0"/>
                                        <TextBlock x:Name="CompilationMode" Text="speed"
                                                   Style="{StaticResource SectionValue}" Foreground="#C4A8FF" Margin="0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{h:Translate Report_Compilation_Dex}" Style="{StaticResource SectionDetail}" Margin="0"/>
                                        <TextBlock x:Name="DexStatus" Text="—"
                                                   Style="{StaticResource SectionValue}" Margin="0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <Button x:Name="DoneButton" Grid.Row="3"
                        Style="{StaticResource App.Style.Button}"
                        Content="{h:Translate Report_Button_Done}" Tag="check"
                        MinWidth="160" Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        h:WindowClose.Result="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>