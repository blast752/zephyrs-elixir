<UserControl x:Class="ZephyrsElixir.UI.Pages.Advanced"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:ZephyrsElixir.UI.Helpers"
             PreviewKeyDown="OnRootPreviewKeyDown"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="AnimationSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="2"/>
            <Setter Property="TickFrequency" Value="0.25"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Border x:Name="TrackBackground" 
                                   Grid.Row="1"
                                   Height="8" 
                                   CornerRadius="4"
                                   Background="#1AFFFFFF"
                                   BorderBrush="#3AFFFFFF"
                                   BorderThickness="1"
                                   Margin="12,0"/>
                            
                            <Grid Grid.Row="1" Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Ellipse Grid.Column="0" Width="4" Height="4" Fill="#6AFFFFFF" 
                                         HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Ellipse Grid.Column="1" Width="4" Height="4" Fill="#6AFFFFFF" 
                                        HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Ellipse Grid.Column="2" Width="4" Height="4" Fill="#6AFFFFFF" 
                                        HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Ellipse Grid.Column="3" Width="4" Height="4" Fill="#6AFFFFFF" 
                                        HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Ellipse Grid.Column="3" Width="4" Height="4" Fill="#6AFFFFFF" 
                                        HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <Border x:Name="ProgressFill"
                                   Grid.Row="1"
                                   Height="6"
                                   CornerRadius="3"
                                   Margin="13,0"
                                   HorizontalAlignment="Left"
                                   Background="{StaticResource App.Brush.IconCircle}"
                                   Width="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, 
                                          Converter={StaticResource App.Converter.PercentageToScale}, 
                                          ConverterParameter=ActualWidth}">
                                <Border.Effect>
                                    <DropShadowEffect Color="{StaticResource App.Color.DeepSkyBlue}" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/>
                                </Border.Effect>
                            </Border>
                            
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse x:Name="GlowCircle" 
                                                            Width="32" Height="32" 
                                                            Fill="#4A00BFFF"
                                                            Opacity="0">
                                                        <Ellipse.Effect>
                                                            <BlurEffect Radius="12"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                    
                                                    <Ellipse x:Name="ThumbCircle"
                                                             Width="24" Height="24">
                                                        <Ellipse.Fill>
                                                            <RadialGradientBrush>
                                                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                                                <GradientStop Color="#E0E7FF" Offset="1"/>
                                                            </RadialGradientBrush>
                                                        </Ellipse.Fill>
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="GlowCircle" Property="Opacity" Value="0.6"/>
                                                        <Setter TargetName="ThumbCircle" Property="Width" Value="26"/>
                                                        <Setter TargetName="ThumbCircle" Property="Height" Value="26"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="GlowCircle" Property="Opacity" Value="1"/>
                                                        <Setter TargetName="ThumbCircle" Property="Width" Value="28"/>
                                                        <Setter TargetName="ThumbCircle" Property="Height" Value="28"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <RowDefinition Height="24"/>   <RowDefinition Height="*"/>    </Grid.RowDefinitions>
        
        <h:PageHeader Grid.Row="0"
                    Icon="chip"
                    Title="{h:Translate Advanced_Header}"
                    Subtitle="{h:Translate Advanced_Subtitle}"/>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled" 
                      Padding="0,0,10,0">
            <StackPanel>
                
                <h:ShadowCard Margin="0,0,0,0"
                        Padding="24"
                        ShadowEffect="{StaticResource App.Effect.PageShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Orientation="Horizontal">
                            <h:Icon Kind="lock" Size="26" Foreground="{StaticResource App.Brush.DeepSkyBlue}" VerticalAlignment="Center"/>
                            <TextBlock Text="{h:Translate Advanced_Privacy_Header}"
                                      FontSize="22" 
                                      FontWeight="SemiBold"
                                      Foreground="White" 
                                      VerticalAlignment="Center"
                                      Margin="15,0,0,0"/>
                        </StackPanel>
                        
                        <Border Grid.Row="1" 
                               Background="{StaticResource App.Brush.Glass.Border}" 
                               Height="1" 
                               VerticalAlignment="Center"/>
                        
                        <StackPanel Grid.Row="2" Margin="0,15,0,0">
                            
                            <Border Style="{StaticResource App.Style.SoftTile}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{h:Translate Advanced_SafetyCore_Title}"
                                                  FontSize="16" 
                                                  FontWeight="SemiBold"
                                                  Foreground="White"/>
                                        <TextBlock Text="{h:Translate Advanced_SafetyCore_Description}"
                                                  FontSize="13"
                                                  Foreground="#B0B8C8"
                                                  TextWrapping="Wrap" 
                                                  Margin="0,4,20,0"/>
                                    </StackPanel>
                                    
                                    <Button x:Name="SafetyCoreButton" 
                                           Grid.Column="1"
                                           Style="{StaticResource App.Style.Button}"
                                           Content="{h:Translate Advanced_Button_Disable}"
                                           Tag="lock"
                                           Click="OnSafetyCoreClick"
                                           MinWidth="160"
                                           VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource App.Style.SoftTile}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" VerticalAlignment="Center">
                                        <TextBlock Text="{h:Translate Advanced_DNS_Title}"
                                                  FontSize="16" 
                                                  FontWeight="SemiBold"
                                                  Foreground="White"/>
                                        <TextBlock Text="{h:Translate Advanced_DNS_Description}"
                                                  FontSize="13"
                                                  Foreground="#B0B8C8"
                                                  TextWrapping="Wrap" 
                                                  Margin="0,4,0,0"/>
                                    </StackPanel>
                                    
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="15"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <ComboBox x:Name="DnsProviderComboBox"
                                                Grid.Column="0"
                                                Style="{StaticResource App.Style.ComboBox}"
                                                MinHeight="48"
                                                VerticalAlignment="Center"
                                                DropDownOpened="OnDnsComboBoxDropDownOpened"
                                                DropDownClosed="OnDnsComboBoxDropDownClosed"
                                                SelectionChanged="OnDnsSelectionChanged">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <TextBlock Grid.Column="0"
                                                                Text="{Binding Name}"
                                                                FontSize="14"
                                                                FontWeight="SemiBold"
                                                                Foreground="White"
                                                                VerticalAlignment="Center"/>
                                                        
                                                        <TextBlock Grid.Column="1"
                                                                Text="{Binding PingDisplay}"
                                                                FontSize="12"
                                                                FontWeight="Normal"
                                                                Foreground="{StaticResource App.Brush.DeepSkyBlue}"
                                                                Margin="15,0,0,0"
                                                                VerticalAlignment="Center"
                                                                MinWidth="60"
                                                                TextAlignment="Right">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding PingDisplay}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        
                                        <Button x:Name="ApplyDnsButton"
                                               Grid.Column="2"
                                               Style="{StaticResource App.Style.Button}"
                                               Content="{h:Translate Advanced_Button_Apply}"
                                               Tag="globe"
                                               Click="OnApplyDnsClick"
                                               MinWidth="160"
                                               VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid x:Name="CustomDnsPanel" Grid.Row="3" Margin="0,12,0,0" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <h:Icon Kind="bolt" Size="18" Foreground="{StaticResource App.Brush.DeepSkyBlue}" VerticalAlignment="Center"/>
                                        <Grid Grid.Column="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="CustomDnsBox"
                                                    Style="{StaticResource App.Style.TextBox.Glass}"
                                                    Tag="{h:Translate Advanced_DNS_Custom_Placeholder}"
                                                    Height="42"
                                                    VerticalAlignment="Center"
                                                    TextChanged="OnCustomDnsTextChanged"/>
                                            <Border x:Name="CustomDnsValidBadge"
                                                   Grid.Column="1"
                                                   Background="#2A00D68F"
                                                   BorderBrush="#00D68F"
                                                   BorderThickness="1"
                                                   CornerRadius="8"
                                                   Padding="10,4"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="Collapsed">
                                                <h:Icon Kind="check" Size="15" x:Name="CustomDnsValidText" Foreground="#00D68F" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource App.Style.SoftTile}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{h:Translate Advanced_ResetAdId_Title}"
                                                  FontSize="16" 
                                                  FontWeight="SemiBold"
                                                  Foreground="White"/>
                                        <TextBlock Text="{h:Translate Advanced_ResetAdId_Description}"
                                                  FontSize="13"
                                                  Foreground="#B0B8C8"
                                                  TextWrapping="Wrap" 
                                                  Margin="0,4,20,0"/>
                                    </StackPanel>
                                    
                                    <Button x:Name="ResetAdIdButton" 
                                           Grid.Column="1"
                                           Style="{StaticResource App.Style.Button}"
                                           Content="{h:Translate Advanced_Button_Reset}"
                                           Tag="key"
                                           Click="OnResetAdIdClick"
                                           MinWidth="160"
                                           VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource App.Style.SoftTile}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{h:Translate Advanced_CaptivePortal_Title}"
                                                FontSize="16" 
                                                FontWeight="SemiBold"
                                                Foreground="White"/>
                                        <TextBlock Text="{h:Translate Advanced_CaptivePortal_Description}"
                                                FontSize="13"
                                                Foreground="#B0B8C8"
                                                TextWrapping="Wrap" 
                                                Margin="0,4,20,0"/>
                                    </StackPanel>
                                    
                                    <Button x:Name="CaptivePortalButton" 
                                        Grid.Column="1"
                                        Style="{StaticResource App.Style.Button}"
                                        Content="{h:Translate Advanced_Button_Disable}"
                                        Tag="globe"
                                        Click="OnCaptivePortalClick"
                                        MinWidth="160"
                                        VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource App.Style.SoftTile}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{h:Translate Advanced_GoogleCoreControl_Title}"
                                                FontSize="16" 
                                                FontWeight="SemiBold"
                                                Foreground="White"/>
                                        <TextBlock Text="{h:Translate Advanced_GoogleCoreControl_Description}"
                                                FontSize="13"
                                                Foreground="#B0B8C8"
                                                TextWrapping="Wrap" 
                                                Margin="0,4,20,0"/>
                                    </StackPanel>
                                    
                                    <Button x:Name="GoogleCoreControlButton" 
                                        Grid.Column="1"
                                        Style="{StaticResource App.Style.Button}"
                                        Content="{h:Translate Advanced_Button_Disable}"
                                        Tag="lock"
                                        Click="OnGoogleCoreControlClick"
                                        MinWidth="160"
                                        VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border x:Name="RamExpansionBorder"
                                Style="{StaticResource App.Style.SoftTile}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{h:Translate Advanced_RamExpansion_Title}"
                                                FontSize="16" 
                                                FontWeight="SemiBold"
                                                Foreground="White"/>
                                        <TextBlock x:Name="RamExpansionDescription"
                                                Text="{h:Translate Advanced_RamExpansion_Description}"
                                                FontSize="13"
                                                Foreground="#B0B8C8"
                                                TextWrapping="Wrap" 
                                                Margin="0,4,20,0"/>
                                    </StackPanel>
                                    
                                    <Button x:Name="RamExpansionButton" 
                                        Grid.Column="1"
                                        Style="{StaticResource App.Style.Button}"
                                        Content="{h:Translate Advanced_Button_Disable}"
                                        Tag="flame"
                                        Click="OnRamExpansionClick"
                                        MinWidth="160"
                                        VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            
                            <Border x:Name="PrivacyStatusBorder" 
                                   Background="#2A1E3A5F" 
                                   CornerRadius="12" 
                                   Padding="16"
                                   Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <h:Icon Kind="info" Size="20" Foreground="{StaticResource App.Brush.DeepSkyBlue}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="PrivacyStatusText"
                                              FontSize="14"
                                              Foreground="White"
                                              TextWrapping="Wrap"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            
                        </StackPanel>
                    </Grid>
                </h:ShadowCard>

                <h:ShadowCard Margin="0,20,0,0"
                        Padding="24"
                        ShadowEffect="{StaticResource App.Effect.PageShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Orientation="Horizontal">
                            <h:Icon Kind="bolt" Size="26" Foreground="#FFD700" VerticalAlignment="Center"/>
                            <TextBlock Text="{h:Translate Advanced_Animations_Header}"
                                      FontSize="22" 
                                      FontWeight="SemiBold"
                                      Foreground="White" 
                                      VerticalAlignment="Center"
                                      Margin="15,0,0,0"/>
                        </StackPanel>
                        
                        <Border Grid.Row="1" 
                               Background="{StaticResource App.Brush.Glass.Border}" 
                               Height="1" 
                               VerticalAlignment="Center"/>
                        
                        <StackPanel Grid.Row="2" Margin="0,15,0,0">
                            
                            <Border Style="{StaticResource App.Style.SoftTile}" Padding="24" Margin="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <Grid Grid.Row="0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{h:Translate Advanced_AnimationSpeed_Title}"
                                                      FontSize="16" 
                                                      FontWeight="SemiBold"
                                                      Foreground="White"/>
                                            <TextBlock Text="{h:Translate Advanced_AnimationSpeed_Description}"
                                                      FontSize="13"
                                                      Foreground="#B0B8C8"
                                                      TextWrapping="Wrap" 
                                                      Margin="0,4,0,0"/>
                                        </StackPanel>
                                        
                                        <Button x:Name="ResetAnimationsButton" 
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource App.Style.Button}"
                                               Content="{h:Translate Advanced_Button_Reset}"
                                               Tag="refresh"
                                               Click="OnResetAnimationsClick"
                                               MinWidth="130"
                                               VerticalAlignment="Top"/>
                                    </Grid>
                                    
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Slider x:Name="AnimationSlider"
                                               Grid.Column="0"
                                               Style="{StaticResource AnimationSliderStyle}"
                                               Value="1.0"
                                               ValueChanged="OnAnimationSliderChanged"
                                               PreviewMouseDown="OnSliderMouseDown"
                                               PreviewMouseUp="OnSliderMouseUp"
                                               Margin="0,0,20,0"/>
                                        
                                        <Border Grid.Column="1"
                                               Background="#2A00BFFF"
                                               BorderBrush="#4A00BFFF"
                                               BorderThickness="1"
                                               CornerRadius="8"
                                               Padding="12,8">
                                            <TextBlock x:Name="AnimationValueText"
                                                      Text="1.0x"
                                                      FontSize="18"
                                                      FontWeight="Bold"
                                                      Foreground="White"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                    
                                    <Grid Grid.Row="4" Margin="0,0,120,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0" 
                                                  Text="{h:Translate Advanced_Animation_Off}"
                                                  FontSize="12" 
                                                  Foreground="#80FFFFFF"
                                                  HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="1" 
                                                  Text="{h:Translate Advanced_Animation_Default}"
                                                  FontSize="12" 
                                                  Foreground="#80FFFFFF"
                                                  HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" 
                                                  Text="{h:Translate Advanced_Animation_Slow}"
                                                  FontSize="12" 
                                                  Foreground="#80FFFFFF"
                                                  HorizontalAlignment="Right"/>
                                    </Grid>
                                </Grid>
                            </Border>
                            
                            <Button x:Name="ApplyAnimationsButton" 
                                   Style="{StaticResource App.Style.Button}"
                                   Content="{h:Translate Advanced_Button_ApplyAnimations}"
                                   Tag="check"
                                   Click="OnApplyAnimationsClick"
                                   Margin="0,15,0,0"
                                   HorizontalAlignment="Right"
                                   MinWidth="200"/>
                            
                        </StackPanel>
                    </Grid>
                </h:ShadowCard>

                <h:ShadowCard Margin="0,20,0,0"
                        Padding="24"
                        ShadowEffect="{StaticResource App.Effect.PageShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <h:Icon Kind="wrench" Size="26" Foreground="#FF6B6B" VerticalAlignment="Center"/>
                            <TextBlock Text="{h:Translate Advanced_Troubleshooting_Header}"
                                      FontSize="22" 
                                      FontWeight="SemiBold"
                                      Foreground="White" 
                                      VerticalAlignment="Center"
                                      Margin="15,0,0,0"/>
                        </StackPanel>
                        
                        <Border Grid.Row="1" 
                               Background="{StaticResource App.Brush.Glass.Border}" 
                               Height="1" 
                               VerticalAlignment="Center"/>
                        
                        <StackPanel Grid.Row="2" Margin="0,15,0,0">
                            
                            <Border Style="{StaticResource App.Style.SoftTile}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{h:Translate Advanced_ResetBattery_Title}"
                                                  FontSize="16" 
                                                  FontWeight="SemiBold"
                                                  Foreground="White"/>
                                        <TextBlock Text="{h:Translate Advanced_ResetBattery_Description}"
                                                  FontSize="13"
                                                  Foreground="#B0B8C8"
                                                  TextWrapping="Wrap" 
                                                  Margin="0,4,20,0"/>
                                    </StackPanel>
                                    
                                    <Button x:Name="ResetBatteryButton" 
                                           Grid.Column="1"
                                           Style="{StaticResource App.Style.Button}"
                                           Content="{h:Translate Advanced_Button_Reset}"
                                           Tag="copy"
                                           Click="OnResetBatteryClick"
                                           MinWidth="160"
                                           VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource App.Style.SoftTile}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{h:Translate Advanced_ResetCompilation_Title}"
                                                  FontSize="16" 
                                                  FontWeight="SemiBold"
                                                  Foreground="White"/>
                                        <TextBlock Text="{h:Translate Advanced_ResetCompilation_Description}"
                                                  FontSize="13"
                                                  Foreground="#B0B8C8"
                                                  TextWrapping="Wrap" 
                                                  Margin="0,4,20,0"/>
                                    </StackPanel>
                                    
                                    <Button x:Name="ResetCompilationButton" 
                                           Grid.Column="1"
                                           Style="{StaticResource App.Style.Button.Destructive}"
                                           Content="{h:Translate Advanced_Button_Reset}"
                                           Tag="delete"
                                           Click="OnResetCompilationClick"
                                           MinWidth="160"
                                           VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource App.Style.SoftTile.Destructive}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{h:Translate Advanced_ResetAll_Title}"
                                                  FontSize="16" 
                                                  FontWeight="SemiBold"
                                                  Foreground="#FFC0C0"/>
                                        <TextBlock x:Name="SessionOperationsText"
                                                  Text="{h:Translate Advanced_ResetAll_Description}"
                                                  FontSize="13"
                                                  Foreground="#B0B8C8"
                                                  TextWrapping="Wrap" 
                                                  Margin="0,4,20,0"/>
                                    </StackPanel>
                                    
                                    <Button x:Name="ResetAllButton" 
                                           Grid.Column="1"
                                           Style="{StaticResource App.Style.Button.Destructive}"
                                           Content="{h:Translate Advanced_Button_ResetAll}"
                                           Tag="delete"
                                           Click="OnResetAllClick"
                                           MinWidth="160"
                                           VerticalAlignment="Center"
                                           IsEnabled="False"/>
                                </Grid>
                            </Border>

                            <Border x:Name="TroubleshootingStatusBorder" 
                                   Background="#2A1E3A5F" 
                                   CornerRadius="12" 
                                   Padding="16"
                                   Margin="0,15,0,0"
                                   Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <h:Icon Kind="info" Size="20" Foreground="{StaticResource App.Brush.DeepSkyBlue}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="TroubleshootingStatusText"
                                              FontSize="14"
                                              Foreground="White"
                                              TextWrapping="Wrap"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            
                        </StackPanel>
                    </Grid>
                </h:ShadowCard>

                <h:ShadowCard Margin="0,20,0,30"
                        Padding="24"
                        ShadowEffect="{StaticResource App.Effect.PageShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <h:Icon Kind="clock" Size="26" Foreground="#9F8CFF" VerticalAlignment="Center"/>
                                <TextBlock Text="{h:Translate Advanced_Vials_Header}"
                                          FontSize="22"
                                          FontWeight="SemiBold"
                                          Foreground="White"
                                          VerticalAlignment="Center"
                                          Margin="15,0,0,0"/>
                            </StackPanel>
                            <Button x:Name="BottleNowButton"
                                   Grid.Column="2"
                                   Style="{StaticResource App.Style.Button.Inline}"
                                   Content="{h:Translate Advanced_Vials_BottleNow}"
                                   Tag="save"
                                   ToolTip="{h:Translate Advanced_Vials_BottleNow_Tooltip}"
                                   Click="OnBottleNowClick"
                                   VerticalAlignment="Center"/>
                        </Grid>

                        <Border Grid.Row="1"
                               Background="{StaticResource App.Brush.Glass.Border}"
                               Height="1"
                               VerticalAlignment="Center"/>

                        <StackPanel Grid.Row="2" Margin="0,15,0,0">
                            <TextBlock Text="{h:Translate Advanced_Vials_Tagline}"
                                      FontSize="13"
                                      Foreground="#B0B8C8"
                                      TextWrapping="Wrap"/>

                            <ItemsControl x:Name="VialsList" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource App.Style.SoftTile}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Width="40" Height="40" CornerRadius="20" Background="#2A7D64FF" VerticalAlignment="Center">
                                                    <h:Icon Kind="clock" Size="18" Foreground="#9F8CFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TriggerDisplay}" FontSize="14" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding MetaDisplay}" FontSize="12" Foreground="#B0B8C8" Margin="0,3,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource App.Style.Button.Inline}"
                                                           Content="{h:Translate Advanced_Vials_Open}"
                                                           Tag="view"
                                                           Click="OnOpenVialClick"
                                                           Margin="0,0,8,0"/>
                                                    <Button Style="{StaticResource App.Style.Button.Inline.Destructive}"
                                                           Content="{h:Translate Debloat_Button_Forget}"
                                                           Tag="delete"
                                                           Click="OnDeleteVialClick"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border x:Name="VialsEmptyState"
                                   Background="#12FFFFFF"
                                   BorderBrush="{StaticResource App.Brush.Glass.Border}"
                                   BorderThickness="1"
                                   CornerRadius="12"
                                   Padding="20"
                                   Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <h:Icon Kind="schedule" Size="20" Foreground="#7D8CA8" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="VialsEmptyText"
                                              Text="{h:Translate Advanced_Vials_Empty}"
                                              FontSize="13"
                                              Foreground="#B0B8C8"
                                              TextWrapping="Wrap"
                                              MaxWidth="520"
                                              VerticalAlignment="Center"
                                              Margin="12,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="VialsStatusBorder"
                                   Background="#2A1E3A5F"
                                   CornerRadius="12"
                                   Padding="16"
                                   Margin="0,12,0,0"
                                   Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <h:Icon Kind="info" Size="20" Foreground="#9F8CFF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="VialsStatusText"
                                              FontSize="14"
                                              Foreground="White"
                                              TextWrapping="Wrap"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </h:ShadowCard>

            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="VialOverlayContainer" Grid.RowSpan="3" Visibility="Collapsed" Background="#CC050A14" MouseLeftButtonDown="OnVialOverlayBackgroundMouseDown">
            <h:ShadowCard Style="{StaticResource App.Style.OverlayCard}" Width="800" MaxHeight="720" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*" MinHeight="160"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="26" Background="#2A7D64FF" VerticalAlignment="Center">
                            <h:Icon Kind="clock" Size="24" Foreground="#9F8CFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{h:Translate Advanced_Vials_Overlay_Title}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                            <TextBlock x:Name="VialOverlaySubtitle" FontSize="13" Foreground="{StaticResource App.Brush.Steel}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="3" Style="{StaticResource App.Style.WindowControl.Close}" Click="OnCloseVialOverlayClick" VerticalAlignment="Top"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="VialSummaryText" FontSize="13" Foreground="#B0B8C8" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="VialSelectAllCheckBox" Style="{StaticResource App.Style.GlassCheckBox}" Checked="OnVialSelectAll" Unchecked="OnVialSelectAll"/>
                            <TextBlock Text="{h:Translate Debloat_SelectAll}" FontSize="13" Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="4">
                        <StackPanel x:Name="VialDiffLoading" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="200" Style="{StaticResource App.Style.ProgressBar}"/>
                            <TextBlock Text="{h:Translate Advanced_Vials_Comparing}" Foreground="#90FFFFFF" HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="13"/>
                        </StackPanel>

                        <StackPanel x:Name="VialNoChanges" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <h:Icon Kind="star" Size="32" Foreground="{StaticResource App.Brush.Gold}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{h:Translate Advanced_Vials_NoChanges}" Foreground="White" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="480" Margin="0,14,0,0"/>
                        </StackPanel>

                        <ScrollViewer x:Name="VialDiffScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                            <ItemsControl x:Name="VialChangesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#12FFFFFF" BorderBrush="{StaticResource App.Brush.Glass.Border}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,6,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding CanRestore}"
                                                          Style="{StaticResource App.Style.GlassCheckBox}"
                                                          VerticalAlignment="Center"/>

                                                <Border Grid.Column="2" Background="{Binding NamespaceBackground}" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Namespace}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding NamespaceForeground}"/>
                                                </Border>

                                                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Key}" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                        <h:Icon Kind="lock" Size="13" Foreground="{StaticResource App.Brush.Gold}" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="{h:Translate Advanced_Vials_ProtectedTooltip}" Visibility="{Binding IsProtected, Converter={StaticResource App.Converter.BooleanToVisibility}}"/>
                                                    </StackPanel>
                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="2"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="{h:Translate Advanced_Vials_Now}" FontSize="11" Foreground="#7D8CA8" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding CurrentDisplay}" FontFamily="Consolas" FontSize="12" Foreground="#E0E0E0" TextWrapping="Wrap"/>
                                                        <TextBlock Grid.Row="2" Text="{h:Translate Advanced_Vials_Vial}" FontSize="11" Foreground="#9F8CFF" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding VialDisplay}" FontFamily="Consolas" FontSize="12" Foreground="#C8BBFF" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="VialSelectedCountText" FontSize="13" Foreground="{StaticResource App.Brush.Steel}" VerticalAlignment="Center"/>
                        <Button x:Name="VialRestoreButton"
                               Grid.Column="1"
                               Style="{StaticResource App.Style.Button}"
                               BorderBrush="#9F8CFF"
                               Content="{h:Translate Advanced_Vials_RestoreSelected}"
                               Tag="restore"
                               Click="OnRestoreVialSelectedClick"
                               MinWidth="200"
                               IsEnabled="False"/>
                    </Grid>
                </Grid>
            </h:ShadowCard>
        </Grid>
    </Grid>
</UserControl>