                                                                    </StackPanel>
                                                                    <Button Grid.Column="1" Style="{StaticResource App.Style.Button.IconOnly}" Padding="4" Click="OnRemovePackageClick">
                                                                        <h:Icon Kind="close" Size="13" Foreground="#FF6B6B"/>
                                                                    </Button>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
