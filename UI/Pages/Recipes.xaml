                                                    <TextBlock Text="{h:Translate Recipes_Step_Tweaks}" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                                    <TextBlock Text="{h:Translate Recipes_Step_Tweaks_Description}" FontSize="11" Foreground="{StaticResource App.Brush.Steel}" Margin="0,2,0,0"/>
