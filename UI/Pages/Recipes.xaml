                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="{h:Translate Recipes_Picker_Title}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                            <Button Style="{StaticResource App.Style.WindowControl.Close}" Click="OnPickerCancelClick" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        </Grid>

                        <TextBox x:Name="PickerSearch" Grid.Row="1" Style="{StaticResource App.Style.TextBox.Glass}" Height="38"
                                 Tag="{h:Translate Debloat_Search_Placeholder}" TextChanged="OnPickerSearchChanged" Margin="0,0,0,12"/>

                        <Grid Grid.Row="2" MinHeight="260">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="PickerList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#10FFFFFF" CornerRadius="8" Padding="12,7" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource App.Style.GlassCheckBox}" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding PackageName}" FontSize="11" Foreground="{StaticResource App.Brush.Steel}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel x:Name="PickerLoading" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                <ProgressBar IsIndeterminate="True" Width="180" Style="{StaticResource App.Style.ProgressBar}"/>
                                <TextBlock x:Name="PickerStatus" Text="{h:Translate Debloat_Loading}" Foreground="{StaticResource App.Brush.Steel}" FontSize="12"
                                           Margin="0,12,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Style="{StaticResource App.Style.Button}" Background="Transparent" Content="{h:Translate Common_Button_Cancel}"
                                    Tag="close" Click="OnPickerCancelClick" Margin="0,0,12,0" MinWidth="130"/>
                            <Button x:Name="PickerAddButton" Style="{StaticResource App.Style.Button}" Content="{h:Translate Recipes_Picker_AddSelected}"
                                    Tag="add" Click="OnPickerAddClick" MinWidth="170"/>
                        </StackPanel>
                    </Grid>
                </h:ShadowCard>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
