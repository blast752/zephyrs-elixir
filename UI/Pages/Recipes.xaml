                                                    <TextBlock Text="{h:Translate Recipes_Step_Debloat}" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                                    <TextBlock Text="{h:Translate Recipes_Step_Debloat_Description}" FontSize="11" Foreground="{StaticResource App.Brush.Steel}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <CheckBox x:Name="DebEnable" Style="{StaticResource App.Style.ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel Visibility="{Binding IsChecked, ElementName=DebEnable, Converter={StaticResource App.Converter.BooleanToVisibility}}" Margin="0,12,0,0">
                                            <Border Style="{StaticResource App.Style.SegmentedContainer}" Width="300" HorizontalAlignment="Left" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
