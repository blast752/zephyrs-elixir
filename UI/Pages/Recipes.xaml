                                <Border Style="{StaticResource Recipes.Style.SectionCard}">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <h:Icon Kind="settings" Size="18" Foreground="{StaticResource App.Brush.DeepSkyBlue}" VerticalAlignment="Center"/>
                                                <StackPanel Margin="12,0,0,0">
                                                    <TextBlock Text="{h:Translate Recipes_Step_Optimization}" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                                    <TextBlock Text="{h:Translate Recipes_Step_Optimization_Description}" FontSize="11" Foreground="{StaticResource App.Brush.Steel}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <CheckBox x:Name="OptEnable" Style="{StaticResource App.Style.ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel Visibility="{Binding IsChecked, ElementName=OptEnable, Converter={StaticResource App.Converter.BooleanToVisibility}}" Margin="0,12,0,0">
                                            <Border Background="#0DFFD700" CornerRadius="10" Padding="12,9" BorderBrush="#18FFD700" BorderThickness="1">
                                                <CheckBox x:Name="ExtremeCheck" Style="{StaticResource App.Style.ToggleSwitch.Extreme}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <h:Icon Kind="bolt" Size="15" Foreground="{StaticResource App.Brush.Gold}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{h:Translate Optimize_ExtremeMode_Label}" FontSize="12" FontWeight="SemiBold" Foreground="#C8D8E8" VerticalAlignment="Center"/>
                                                        <Border Style="{StaticResource Recipes.Style.ProTag}" Margin="10,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="PRO" FontSize="9" FontWeight="Bold" Foreground="{StaticResource App.Brush.Gold}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </CheckBox>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Recipes.Style.SectionCard}">
