                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <h:Icon Kind="download" Size="18" Foreground="{StaticResource App.Brush.DeepSkyBlue}" VerticalAlignment="Center"/>
                                                <StackPanel Margin="12,0,0,0">
                                                    <TextBlock Text="{h:Translate Recipes_Step_Install}" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                                    <TextBlock Text="{h:Translate Recipes_Step_Install_Description}" FontSize="11" Foreground="{StaticResource App.Brush.Steel}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <CheckBox x:Name="InstEnable" Style="{StaticResource App.Style.ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel Visibility="{Binding IsChecked, ElementName=InstEnable, Converter={StaticResource App.Converter.BooleanToVisibility}}" Margin="0,12,0,0">
                                            <ItemsControl x:Name="ApksList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="2,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="10"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <h:Icon Size="15">
                                                                <h:Icon.Style>
                                                                    <Style TargetType="{x:Type h:Icon}">
                                                                        <Setter Property="Kind" Value="warning"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource App.Brush.Gold}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsResolved}" Value="True">
                                                                                <Setter Property="Kind" Value="check"/>
                                                                                <Setter Property="Foreground" Value="#00D68F"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </h:Icon.Style>
                                                            </h:Icon>
                                                            <TextBlock Grid.Column="2" Text="{Binding FileName}" FontSize="12" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <Button Grid.Column="3" Style="{StaticResource App.Style.Button.IconOnly}" Padding="4" Click="OnRemoveApkClick">
                                                                <h:Icon Kind="close" Size="13" Foreground="#FF6B6B"/>
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock x:Name="ApkHint" Text="{h:Translate Recipes_Install_Hint}" FontSize="11"
