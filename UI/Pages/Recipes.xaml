                                                                 Style="{StaticResource App.Style.SegmentedRadioButton}"/>
                                                    <RadioButton x:Name="DebModeDisable" Grid.Column="1" Content="{h:Translate Recipes_Debloat_ModeDisable}" GroupName="DebMode"
                                                                 Style="{StaticResource App.Style.SegmentedRadioButton}"/>
                                                </Grid>
                                            </Border>

                                            <Border Background="#15000000" CornerRadius="8" BorderBrush="{StaticResource App.Brush.Glass.Border}" BorderThickness="1">
                                                <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl x:Name="PackagesList">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="12,5">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                                   Visibility="{Binding Label, Converter={x:Static h:StringToVisibilityConverter.Instance}}" Margin="0,0,8,0"/>
