                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="PkgInput" Style="{StaticResource App.Style.TextBox.Glass}" Height="36"
                                                         Tag="{h:Translate Recipes_Debloat_AddPlaceholder}" KeyDown="OnPkgInputKeyDown"/>
                                                <Button Grid.Column="2" Style="{StaticResource App.Style.Button.Inline}" Content="{h:Translate Recipes_Button_Add}" Tag="add" Click="OnAddPackageClick"/>
                                                <Button Grid.Column="4" x:Name="FromDeviceButton" Style="{StaticResource App.Style.Button.Inline}" Content="{h:Translate Recipes_Button_FromDevice}" Tag="phone" Click="OnFromDeviceClick"/>
                                            </Grid>
                                            <TextBlock x:Name="PkgError" FontSize="11" Foreground="#FF6B6B" Margin="2,6,0,0" Visibility="Collapsed"
                                                       Text="{h:Translate Recipes_Error_InvalidPackage}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Recipes.Style.SectionCard}">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <h:Icon Kind="chart" Size="18" Foreground="{StaticResource App.Brush.Gold}" VerticalAlignment="Center"/>
