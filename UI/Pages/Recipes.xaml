                                        <TextBlock Text="{h:Translate Recipes_Editor_Author}" FontSize="12" FontWeight="SemiBold" Foreground="#C8D8E8" Margin="0,0,0,6"/>
                                        <TextBox x:Name="EditorAuthor" Style="{StaticResource App.Style.TextBox.Glass}" Height="40"
