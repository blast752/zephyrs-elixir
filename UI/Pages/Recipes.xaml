                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="220"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{h:Translate Advanced_AnimationSpeed_Title}" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                                                <ComboBox x:Name="AnimCombo" Grid.Column="1" Style="{StaticResource App.Style.ComboBox.Slim}"/>
                                            </Grid>
                                            <Border Background="{StaticResource App.Brush.Glass.Border}" Height="1" Margin="0,10"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <h:Icon Kind="lock" Size="14" Foreground="{StaticResource App.Brush.Gold}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{h:Translate Recipes_Tweaks_ProPrivacy}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource App.Brush.Gold}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel x:Name="ProPrivacyPanel"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Recipes.Style.SectionCard}">
