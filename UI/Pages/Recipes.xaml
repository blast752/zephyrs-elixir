                                            <h:Icon Kind="bolt" Size="15" Foreground="{StaticResource App.Brush.Gold}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{h:Translate Recipes_Run_ProNote}" FontSize="12" Foreground="#E8D8A8" Margin="10,0,0,0"
                                                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="480"/>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="RunDebloatNote" Background="#15FFFFFF" CornerRadius="10" Padding="12,10" Margin="0,8,0,0" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <h:Icon Kind="refresh" Size="15" Foreground="{StaticResource App.Brush.DeepSkyBlue}" VerticalAlignment="Center"/>
