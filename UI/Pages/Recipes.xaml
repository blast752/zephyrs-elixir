<UserControl x:Class="ZephyrsElixir.UI.Pages.Recipes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:h="clr-namespace:ZephyrsElixir.UI.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="860" d:DesignWidth="1120"
             Background="Transparent"
             x:Name="Root">

    <UserControl.Resources>
        <Style x:Key="Recipes.Style.Chip" TargetType="Border">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
        <Style x:Key="Recipes.Style.ChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#C8D8E8"/>
        </Style>
        <Style x:Key="Recipes.Style.ProTag" TargetType="Border">
            <Setter Property="Background" Value="#20FFD700"/>
            <Setter Property="BorderBrush" Value="#40FFD700"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="7,2"/>
        </Style>
        <Style x:Key="Recipes.Style.StatTile" TargetType="Border">
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="MinWidth" Value="68"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="Recipes.Style.StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Recipes.Style.StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{StaticResource App.Brush.Steel}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="Recipes.Style.RowCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource App.Brush.Idle}"/>
            <Setter Property="BorderBrush" Value="{StaticResource App.Brush.Glass.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource App.Brush.Hover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Recipes.Style.SectionCard" TargetType="Border" BasedOn="{StaticResource App.Style.GlassCard}">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Recipes.Style.IconTile" TargetType="Border">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Recipes.Style.IconTileGlyph" TargetType="{x:Type h:Icon}">
            <Setter Property="Size" Value="21"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="Recipes.Style.GlyphOption" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Tile" Width="46" Height="46" CornerRadius="11"
                                Background="{TemplateBinding Background}" Opacity="0.45"
                                BorderThickness="2" BorderBrush="Transparent">
                            <h:Icon Kind="{TemplateBinding Content}" Size="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tile" Property="Opacity" Value="1"/>
                                <Setter TargetName="Tile" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="Recipes.Template.Chips">
            <Border Style="{StaticResource Recipes.Style.Chip}">
                <TextBlock Text="{Binding}" Style="{StaticResource Recipes.Style.ChipText}"/>
            </Border>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="Recipes.Panel.Wrap">
            <WrapPanel/>
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <h:PageHeader x:Name="PageHeaderControl" Grid.Row="0"
                      Icon="library"
                      Title="{h:Translate Recipes_Header}"
                      Subtitle="{h:Translate Recipes_Subtitle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource App.Style.SegmentedContainer}" Width="280">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="LibraryTab"
                                     Content="{h:Translate Recipes_Tab_Library}"
                                     GroupName="RecipesTab"
                                     IsChecked="True"
                                     Style="{StaticResource App.Style.SegmentedRadioButton}"
                                     Checked="OnTabChanged"/>
                        <RadioButton x:Name="CommunityTab"
                                     Grid.Column="1"
                                     Content="{h:Translate Recipes_Tab_Community}"
                                     GroupName="RecipesTab"
                                     Style="{StaticResource App.Style.SegmentedRadioButton}"
                                     Checked="OnTabChanged"/>
                    </Grid>
                </Border>

                <Button x:Name="ImportButton"
                        Grid.Column="2"
                        Style="{StaticResource App.Style.Button}"
                        Content="{h:Translate Recipes_Button_Import}"
                        Tag="import-file"
                        Click="OnImportClick"
                        MinWidth="130"/>

                <Button x:Name="NewButton"
                        Grid.Column="4"
                        Style="{StaticResource App.Style.Button}"
                        Content="{h:Translate Recipes_Button_New}"
                        Tag="add"
                        Click="OnNewClick"
                        MinWidth="150"/>
            </Grid>
        </h:PageHeader>

        <h:ShadowCard Grid.Row="2"
                      Padding="24"
                      ClipToBounds="False"
                      ShadowEffect="{StaticResource App.Effect.PageShadow}">
            <Grid>

                <Grid x:Name="LibraryPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="BrewmasterBar" Grid.Row="0" Margin="0,0,0,18" CornerRadius="16" Padding="16,13"
                            Background="{StaticResource App.Brush.BrewBar}"
                            BorderBrush="{StaticResource App.Brush.Glass.Border}" BorderThickness="1"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*" MinWidth="90"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="78" Height="78" VerticalAlignment="Center">
                                <Ellipse Style="{StaticResource App.Style.Aura.Pulse}" Fill="{StaticResource App.Brush.Mascot.Halo}">
                                    <Ellipse.Effect><BlurEffect Radius="16"/></Ellipse.Effect>
                                </Ellipse>
                                <Image Source="pack://application:,,,/Assets/Images/mascotte.png"
                                       Width="70" Height="70" Stretch="Uniform"
                                       Style="{StaticResource App.Style.Mascot.Float}"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>

                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <Border Width="13" Height="13" Background="#22FFFFFF" HorizontalAlignment="Left"
                                        VerticalAlignment="Center" Margin="-3,0,0,0" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform><RotateTransform Angle="45"/></Border.RenderTransform>
                                </Border>
                                <Border Background="#22FFFFFF" CornerRadius="12" Padding="15,11" Margin="5,0,0,0"
                                        BorderBrush="{StaticResource App.Brush.Glass.Border}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{h:Translate Recipes_Mascot_Name}" FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource App.Brush.DeepSkyBlue}"/>
                                        <TextBlock x:Name="TipText" Text="{Binding Tip}" FontSize="12.5" Foreground="#E4ECF8"
                                                   TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="17"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Ghost border carries the glow so the level text keeps ClearType — an Effect rasterizes its whole subtree. -->
                                    <Grid>
                                        <Border Background="{StaticResource App.Brush.Rank}" CornerRadius="9"
                                                Effect="{StaticResource App.Effect.GoldGlow.Small}"/>
                                        <Border Background="{StaticResource App.Brush.Rank}" CornerRadius="9" Padding="9,3">
                                            <TextBlock Text="{Binding LevelLabel}" FontSize="11" FontWeight="Bold" Foreground="#101010"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="White"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid Width="230" HorizontalAlignment="Left" Margin="0,9,0,0">
                                    <Border Height="7" Background="#20FFFFFF" CornerRadius="3.5"/>
                                    <Border Height="7" HorizontalAlignment="Left" CornerRadius="3.5"
                                            Background="{StaticResource App.Brush.Rank.Track}">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource App.Converter.BatteryWidthConverter}">
                                                <Binding Path="ProgressPercent"/>
                                                <Binding Source="230"/>
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding XpLabel}" FontSize="10.5" Foreground="{StaticResource App.Brush.Steel}"/>
                                    <TextBlock Text="  •  " FontSize="10.5" Foreground="#50FFFFFF"/>
                                    <TextBlock Text="{Binding NextRankLabel}" FontSize="10.5" Foreground="{StaticResource App.Brush.DeepSkyBlue}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource Recipes.Style.StatTile}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding RecipesValue}" Style="{StaticResource Recipes.Style.StatValue}" Foreground="White"/>
                                        <TextBlock Text="{h:Translate Recipes_Gamify_Recipes}" Style="{StaticResource Recipes.Style.StatLabel}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Recipes.Style.StatTile}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding BrewsValue}" Style="{StaticResource Recipes.Style.StatValue}" Foreground="{StaticResource App.Brush.Gold}"/>
                                        <TextBlock Text="{h:Translate Recipes_Gamify_Brews}" Style="{StaticResource Recipes.Style.StatLabel}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Recipes.Style.StatTile}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SharedValue}" Style="{StaticResource Recipes.Style.StatValue}" Foreground="{StaticResource App.Brush.DeepSkyBlue}"/>
                                        <TextBlock Text="{h:Translate Recipes_Gamify_Shared}" Style="{StaticResource Recipes.Style.StatLabel}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                    <ScrollViewer x:Name="LibraryScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
                        <ItemsControl x:Name="LibraryList" Background="Transparent">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Recipes.Style.RowCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Style="{StaticResource Recipes.Style.IconTile}"
                                                    Background="{Binding IconBrush}" VerticalAlignment="Top">
                                                <h:Icon Kind="{Binding Glyph}" Style="{StaticResource Recipes.Style.IconTileGlyph}"/>
                                            </Border>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                                    <Border Style="{StaticResource Recipes.Style.ProTag}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding RequiresPro, Converter={StaticResource App.Converter.BooleanToVisibility}}">
                                                        <TextBlock Text="PRO" FontSize="9" FontWeight="Bold" Foreground="{StaticResource App.Brush.Gold}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding AuthorDisplay}" FontSize="11" Foreground="{StaticResource App.Brush.Steel}"
                                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource App.Brush.Steel}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,4,0,8" MaxHeight="34" TextWrapping="Wrap"/>
                                                <ItemsControl ItemsSource="{Binding Chips}"
                                                              ItemTemplate="{StaticResource Recipes.Template.Chips}"
                                                              ItemsPanel="{StaticResource Recipes.Panel.Wrap}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <h:Icon Kind="bolt" Size="12" Foreground="{StaticResource App.Brush.Steel}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding AppliedDisplay}" FontSize="11" Foreground="{StaticResource App.Brush.Steel}"
                                                               Margin="5,0,14,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding UpdatedDisplay}" FontSize="11" Foreground="#707888" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource App.Style.Button.Inline}"
                                                        Content="{h:Translate Recipes_Button_Run}"
                                                        Tag="play"
                                                        Click="OnRunRecipeClick"
                                                        Margin="0,0,10,0"/>
                                                <Button Style="{StaticResource App.Style.Button.IconOnly}" Click="OnEditRecipeClick"
                                                        ToolTip="{h:Translate Recipes_Tooltip_Edit}">
                                                    <h:Icon Kind="edit" Size="16" Foreground="#C8D8E8"/>
                                                </Button>
                                                <Button Style="{StaticResource App.Style.Button.IconOnly}" Click="OnDuplicateRecipeClick"
                                                        ToolTip="{h:Translate Recipes_Tooltip_Duplicate}">
                                                    <h:Icon Kind="copy" Size="16" Foreground="#C8D8E8"/>
                                                </Button>
                                                <Button Style="{StaticResource App.Style.Button.IconOnly}" Click="OnExportRecipeClick"
                                                        ToolTip="{h:Translate Recipes_Tooltip_Export}">
                                                    <h:Icon Kind="save" Size="16" Foreground="#C8D8E8"/>
                                                </Button>
                                                <Button Style="{StaticResource App.Style.Button.IconOnly}" Click="OnShareRecipeClick"
                                                        ToolTip="{Binding ShareTooltip}">
                                                    <h:Icon Kind="cloud" Size="16" Foreground="{Binding ShareBrush}"/>
                                                </Button>
                                                <Button Style="{StaticResource App.Style.Button.IconOnly}" Click="OnDeleteRecipeClick"
                                                        ToolTip="{h:Translate Recipes_Tooltip_Delete}">
                                                    <h:Icon Kind="delete" Size="16" Foreground="#FF6B6B"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel x:Name="LibraryEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"
                                RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <ScaleTransform ScaleX="{Binding ActualHeight, ElementName=LibraryPanel, Converter={StaticResource App.Converter.SizeToScale}, ConverterParameter='640,1.5,0.8'}"
                                            ScaleY="{Binding ActualHeight, ElementName=LibraryPanel, Converter={StaticResource App.Converter.SizeToScale}, ConverterParameter='640,1.5,0.8'}"/>
                        </StackPanel.RenderTransform>
                        <Grid Width="204" Height="204" HorizontalAlignment="Center">
                            <Ellipse Style="{StaticResource App.Style.Aura.Pulse}" Fill="{StaticResource App.Brush.Mascot.Halo}">
                                <Ellipse.Effect><BlurEffect Radius="34"/></Ellipse.Effect>
                            </Ellipse>
                            <Image Source="pack://application:,,,/Assets/Images/mascotte.png"
                                   Width="188" Height="188" Stretch="Uniform"
                                   Style="{StaticResource App.Style.Mascot.Float}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>

                        <Border Background="#22FFFFFF" CornerRadius="14" Padding="20,14" Margin="0,8,0,20"
                                MaxWidth="470" BorderBrush="{StaticResource App.Brush.Glass.Border}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{h:Translate Recipes_Mascot_Name}" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource App.Brush.DeepSkyBlue}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{h:Translate Recipes_Mascot_Welcome}" FontSize="15" Foreground="#E4ECF8"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,0" LineHeight="21"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{h:Translate Recipes_Empty_Title}" FontSize="18" FontWeight="SemiBold" Foreground="White"
                                   HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="{h:Translate Recipes_Empty_Text}" FontSize="13" Foreground="{StaticResource App.Brush.Steel}"
                                   HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="410" TextWrapping="Wrap"/>
                        <Button Style="{StaticResource App.Style.Button}" Content="{h:Translate Recipes_Button_New}" Tag="add"
                                Click="OnNewClick" HorizontalAlignment="Center" Margin="0,20,0,0" MinWidth="170"/>
                    </StackPanel>
                    </Grid>
                </Grid>

                <Grid x:Name="CommunityPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="240" MaxWidth="380"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="CommunitySearchBox"
                                 Style="{StaticResource App.Style.TextBox.Glass}"
                                 Tag="{h:Translate Recipes_Community_SearchPlaceholder}"
                                 Height="40"
                                 VerticalAlignment="Center"
                                 TextChanged="OnCommunitySearchChanged"/>

                        <Border Grid.Column="2" Style="{StaticResource App.Style.SegmentedContainer}" Width="330" HorizontalAlignment="Right">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="SortTop" Content="{h:Translate Recipes_Sort_Top}" GroupName="CommunitySort" IsChecked="True"
                                             Style="{StaticResource App.Style.SegmentedRadioButton}" Checked="OnCommunitySortChanged"/>
                                <RadioButton x:Name="SortRecent" Grid.Column="1" Content="{h:Translate Recipes_Sort_Recent}" GroupName="CommunitySort"
                                             Style="{StaticResource App.Style.SegmentedRadioButton}" Checked="OnCommunitySortChanged"/>
                                <RadioButton x:Name="SortUsed" Grid.Column="2" Content="{h:Translate Recipes_Sort_MostUsed}" GroupName="CommunitySort"
                                             Style="{StaticResource App.Style.SegmentedRadioButton}" Checked="OnCommunitySortChanged"/>
                            </Grid>
                        </Border>

                        <Button Grid.Column="3" Style="{StaticResource App.Style.Button.IconOnly}" Click="OnCommunityRefreshClick"
                                Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="{h:Translate Recipes_Tooltip_Refresh}">
                            <h:Icon Kind="refresh" Size="17" Foreground="#C8D8E8"/>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
                            <ItemsControl x:Name="CommunityList" Background="Transparent">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Recipes.Style.RowCard}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="34" Height="46" VerticalAlignment="Top" Margin="0,0,12,0"
                                                        Visibility="{Binding ShowRank, Converter={StaticResource App.Converter.BooleanToVisibility}}">
                                                    <TextBlock Text="{Binding RankDisplay}" FontSize="17" FontWeight="Bold"
                                                               Foreground="{StaticResource App.Brush.Gold}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <Border Grid.Column="1" Style="{StaticResource Recipes.Style.IconTile}"
                                                        Background="{Binding IconBrush}" VerticalAlignment="Top">
                                                    <h:Icon Kind="{Binding Glyph}" Style="{StaticResource Recipes.Style.IconTileGlyph}"/>
                                                </Border>

                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                                        <Border Style="{StaticResource Recipes.Style.ProTag}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding RequiresPro, Converter={StaticResource App.Converter.BooleanToVisibility}}">
                                                            <TextBlock Text="PRO" FontSize="9" FontWeight="Bold" Foreground="{StaticResource App.Brush.Gold}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding AuthorDisplay}" FontSize="11" Foreground="{StaticResource App.Brush.Steel}"
                                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource App.Brush.Steel}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,4,0,8" MaxHeight="34" TextWrapping="Wrap"/>
                                                    <ItemsControl ItemsSource="{Binding Chips}"
                                                                  ItemTemplate="{StaticResource Recipes.Template.Chips}"
                                                                  ItemsPanel="{StaticResource Recipes.Panel.Wrap}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Top" Height="46">
                                                    <Button Style="{StaticResource App.Style.Button.IconOnly}" Click="OnLikeClick"
                                                            VerticalAlignment="Center"
                                                            IsEnabled="{Binding IsBusy, Converter={x:Static h:InverseBoolConverter.Instance}}"
                                                            ToolTip="{h:Translate Recipes_Tooltip_Like}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <h:Icon Size="15">
                                                                <h:Icon.Style>
                                                                    <Style TargetType="{x:Type h:Icon}">
                                                                        <Setter Property="Kind" Value="heart-outline"/>
                                                                        <Setter Property="Foreground" Value="#C8D8E8"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasLiked}" Value="True">
                                                                                <Setter Property="Kind" Value="heart"/>
                                                                                <Setter Property="Foreground" Value="#FF6B81"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </h:Icon.Style>
                                                            </h:Icon>
                                                            <TextBlock Text="{Binding LikesDisplay}" FontSize="12" Foreground="#C8D8E8"
                                                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"
                                                                ToolTip="{h:Translate Recipes_Tooltip_Downloads}">
                                                        <h:Icon Kind="download" Size="14" Foreground="{StaticResource App.Brush.Steel}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding DownloadsDisplay}" FontSize="12" Foreground="{StaticResource App.Brush.Steel}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"
                                                                ToolTip="{h:Translate Recipes_Tooltip_TimesApplied}">
                                                        <h:Icon Kind="bolt" Size="14" Foreground="{StaticResource App.Brush.Steel}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding AppliedDisplay}" FontSize="12" Foreground="{StaticResource App.Brush.Steel}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Grid Grid.Column="7" Height="46" VerticalAlignment="Top">
                                                    <Button Style="{StaticResource App.Style.Button.Inline}"
                                                            Content="{h:Translate Recipes_Button_Get}"
                                                            Tag="download"
                                                            Click="OnGetCommunityClick"
                                                            IsEnabled="{Binding IsBusy, Converter={x:Static h:InverseBoolConverter.Instance}}"
                                                            VerticalAlignment="Center"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
