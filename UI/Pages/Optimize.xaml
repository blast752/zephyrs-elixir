<UserControl x:Class="ZephyrsElixir.UI.Pages.Optimize"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:ZephyrsElixir.UI.Helpers"
             Background="Transparent">

    <UserControl.Resources>
        <Storyboard x:Key="Optimize.Storyboard.PulseGlow" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ActiveGlowRing" 
                             Storyboard.TargetProperty="Opacity"
                             From="0.3" To="0.8" Duration="0:0:1.2"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ActiveGlowRing" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="1" To="1.15" Duration="0:0:1.2"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ActiveGlowRing" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="1" To="1.15" Duration="0:0:1.2"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid Margin="28,24" ClipToBounds="True">
        <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False" Opacity="0.85"/>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <h:ShadowCard x:Name="DeviceStatusCard" Grid.Row="0" 
                    Padding="20,14"
                    ShadowEffect="{StaticResource App.Effect.PageShadow}"
                    RenderTransformOrigin="0.5,0.5">
                <h:ShadowCard.RenderTransform>
                    <TranslateTransform x:Name="StatusCardTranslate" Y="-30"/>
                </h:ShadowCard.RenderTransform>
                <h:ShadowCard.Opacity>0</h:ShadowCard.Opacity>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Margin="0,0,16,0">
                            <h:GlowIcon Size="48" CornerRadius="24"
                                    Background="{StaticResource App.Brush.IconCircle}">
                                <h:GlowIcon.GlowEffect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" 
                                                    Color="{StaticResource App.Color.Blue300}" Opacity="0.5"/>
                                </h:GlowIcon.GlowEffect>
                                <TextBlock Text="&#xE8EA;"
                                        Style="{StaticResource App.Style.Glyph}" 
                                        FontSize="22" HorizontalAlignment="Center"/>
                            </h:GlowIcon>
                            <Ellipse x:Name="ConnectionIndicator" 
                                    Width="14" Height="14" 
                                    Fill="{StaticResource App.Brush.Status.Idle}"
                                    Stroke="#30000000" StrokeThickness="2"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,-2,-2">
                                <Ellipse.ToolTip>
                                    <ToolTip Style="{StaticResource App.Style.Tooltip}" 
                                            Content="{h:Translate DeviceStatus_ConnectionStatus_Tooltip}"/>
                                </Ellipse.ToolTip>
                            </Ellipse>
                        </Grid>
                        
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="DeviceNameText" 
                                    Text="{h:Translate DeviceStatus_NoDevice}" 
                                    FontSize="16" FontWeight="SemiBold" Foreground="White"
                                    TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Width="52" Height="20" CornerRadius="10"
                                        Background="#18FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1">
                                    <Border.ToolTip>
                                        <ToolTip Style="{StaticResource App.Style.Tooltip}" 
                                                Content="{h:Translate Optimize_Battery_Tooltip}"/>
                                    </Border.ToolTip>
                                    <Grid>
                                        <Rectangle x:Name="BatteryFill" RadiusX="8" RadiusY="8" 
                                                HorizontalAlignment="Left" Margin="2" Width="0" Height="14">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#7ED321" Offset="0"/>
                                                    <GradientStop Color="#A8E063" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <TextBlock x:Name="BatteryText" Text="—" FontSize="9.5" FontWeight="Bold"
                                                Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{h:Translate Optimize_Battery_Label}" 
                                        Foreground="#7590A8" FontSize="11" 
                                        VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    
                    <Grid Grid.Column="2" 
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Padding="16,8" CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{StaticResource App.Color.Gold}" Offset="0"/>
                                    <GradientStop Color="#FF9500" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="0" 
                                                Color="{StaticResource App.Color.Gold}" Opacity="0.5"/>
                            </Border.Effect>
                        </Border>
                        <Border Padding="16,8" CornerRadius="12" Background="Transparent">
                            <Border.ToolTip>
                                <ToolTip Style="{StaticResource App.Style.Tooltip}" 
                                        Content="{h:Translate Optimize_Timer_Tooltip}"/>
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE916;"
                                        Style="{StaticResource App.Style.Glyph}"
                                        FontSize="15" Foreground="#1E1E1E" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TimerText" Text="00:00:00" 
                                        FontSize="18" FontWeight="Bold" 
                                        FontFamily="Cascadia Code, Consolas"
                                        Foreground="#1E1E1E"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    
                    <Button x:Name="DeviceInfoButton" Grid.Column="4"
                            Style="{StaticResource App.Style.Button}"
                            Content="{h:Translate Optimize_Button_DeviceInfo}" Tag="&#xE946;"
                            Click="OnDeviceInfoClick" MinWidth="150">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource App.Style.Tooltip}" 
                                    Content="{h:Translate Optimize_Button_DeviceInfo_Tooltip}"/>
                        </Button.ToolTip>
                    </Button>
                </Grid>
            </h:ShadowCard>

            <Grid Grid.Row="1" Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="400" MaxWidth="560"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                </Grid.ColumnDefinitions>
                
                <h:ShadowCard x:Name="CenterCard" Grid.Column="0"
                        Padding="32,28"
                        VerticalAlignment="Center" HorizontalAlignment="Stretch"
                        ShadowEffect="{StaticResource App.Effect.PageShadow}"
                        RenderTransformOrigin="0.5,0.5">
                    <h:ShadowCard.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="CardScale" ScaleX="0.85" ScaleY="0.85"/>
                            <TranslateTransform x:Name="CardTranslate" Y="20"/>
                        </TransformGroup>
                    </h:ShadowCard.RenderTransform>
                    <h:ShadowCard.Opacity>0</h:ShadowCard.Opacity>
                    
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <Grid Grid.Row="0" Width="100" Height="100" Margin="0,0,0,20" HorizontalAlignment="Center">
                            <Ellipse x:Name="OuterRing" Width="100" Height="100" StrokeThickness="2.5"
                                     RenderTransformOrigin="0.5,0.5" Opacity="0.9">
                                <Ellipse.Stroke>
                                    <LinearGradientBrush>
                                        <GradientStop Color="#00FFD700" Offset="0"/>
                                        <GradientStop Color="#FFFFD700" Offset="0.2"/>
                                        <GradientStop Color="#FF00BFFF" Offset="0.5"/>
                                        <GradientStop Color="#0000BFFF" Offset="0.8"/>
                                        <GradientStop Color="#00FFD700" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="RingRotation"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            
                            <Ellipse x:Name="ActiveGlowRing" Width="88" Height="88" 
                                     Fill="Transparent" StrokeThickness="4"
                                     Visibility="Collapsed" Opacity="0.3"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.Stroke>
                                    <LinearGradientBrush>
                                        <GradientStop Color="#6000BFFF" Offset="0"/>
                                        <GradientStop Color="#607D64FF" Offset="0.5"/>
                                        <GradientStop Color="#6000BFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                                <Ellipse.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            
                            <h:GlowIcon Size="68" CornerRadius="34"
                                    Background="{StaticResource App.Brush.IconCircle}"
                                    GlowEffect="{StaticResource App.Effect.IconCircleBlueGlow}">
                                <TextBlock x:Name="OptimizeIcon" Text="&#xE9F5;"
                                           Style="{StaticResource App.Style.Glyph}"
                                           FontSize="30" HorizontalAlignment="Center"/>
                            </h:GlowIcon>
                        </Grid>
                        
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <TextBlock Text="{h:Translate Optimize_Header}" 
                                       Style="{StaticResource App.Style.SectionHeader}"
                                       FontSize="22"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{h:Translate Optimize_Subtitle}"
                                       FontSize="13" Foreground="#8898A8" TextAlignment="Center"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"
                                       MaxWidth="380" TextWrapping="Wrap"/>
                        </StackPanel>
                        
                        <Grid Grid.Row="2" Margin="0,0,0,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Grid Grid.Row="0">
                                <TextBlock x:Name="StepLabel" Text="{h:Translate Optimize_Status_Ready}" 
                                           FontSize="12" Foreground="#7090A8" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="ProgressText" Text="0%" 
                                           FontSize="12" FontWeight="SemiBold" Foreground="White" 
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            
                            <ProgressBar x:Name="OptimizeProgress" Grid.Row="2"
                                         Style="{StaticResource App.Style.ProgressBar}"
                                         Value="0" Height="20"/>
                        </Grid>
                        
                        <Border Grid.Row="3" Background="#0DFFD700" CornerRadius="12" Padding="14,11" Margin="0,0,0,18"
                                BorderBrush="#18FFD700" BorderThickness="1">
                            <Border.ToolTip>
                                <ToolTip Style="{StaticResource App.Style.Tooltip}" MaxWidth="280">
                                    <StackPanel>
                                        <TextBlock Text="{h:Translate Optimize_ExtremeMode_Title}" 
                                                   FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4"/>
                                        <TextBlock Text="{h:Translate Optimize_ExtremeMode_Description}" 
                                                   TextWrapping="Wrap" Foreground="#A8B8C8"/>
                                    </StackPanel>
                                </ToolTip>
                            </Border.ToolTip>
                            <CheckBox x:Name="ExtremeModeToggle" 
                                      h:LicenseGuard.RequiredTier="Pro" 
                                      Style="{StaticResource App.Style.ToggleSwitch.Extreme}">
                                <StackPanel Orientation="Horizontal">
                                    <Grid VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource App.Brush.Gold}" Effect="{StaticResource App.Effect.GoldGlow.Small}" IsHitTestVisible="False"/>
                                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource App.Brush.Gold}"/>
                                    </Grid>
                                    <TextBlock Text="{h:Translate Optimize_ExtremeMode_Label}" 
                                               FontSize="13" FontWeight="SemiBold" 
                                               Foreground="#C8D8E8" VerticalAlignment="Center"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>
                        
                        <Button x:Name="OptimizeButton" Grid.Row="4"
                                Style="{StaticResource App.Style.Button}"
                                Content="{h:Translate Optimize_Button_Start}" Tag="&#xE768;"
                                MinWidth="200" MinHeight="56"
                                HorizontalAlignment="Center"
                                Click="OnOptimizeClick">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource App.Style.Tooltip}" 
                                         Content="{h:Translate Optimize_Button_Start_Tooltip}"/>
                            </Button.ToolTip>
                        </Button>
                    </Grid>
                </h:ShadowCard>
                
                <h:ShadowCard x:Name="ConsoleCard" Grid.Column="2" 
                        Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="16"
                        VerticalAlignment="Stretch"
                        ShadowEffect="{StaticResource App.Effect.PageShadow}"
                        RenderTransformOrigin="0.5,0.5">
                    <h:ShadowCard.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ConsoleScale" ScaleX="0.9" ScaleY="0.9"/>
                            <TranslateTransform x:Name="ConsoleTranslate" X="30"/>
                        </TransformGroup>
                    </h:ShadowCard.RenderTransform>
                    <h:ShadowCard.Opacity>0</h:ShadowCard.Opacity>
                    
                    <Border CornerRadius="16" ClipToBounds="True"
                            Background="#18000000" BorderBrush="#20FFD700" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <Border Grid.Row="0" Background="#10FFD700" Padding="16,12">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE756;" Style="{StaticResource App.Style.Glyph}" FontSize="14" Foreground="{StaticResource App.Brush.Gold}" Effect="{StaticResource App.Effect.GoldGlow.Small}" IsHitTestVisible="False"/>
                                            <TextBlock Text="&#xE756;" Style="{StaticResource App.Style.Glyph}" FontSize="14" Foreground="{StaticResource App.Brush.Gold}"/>
                                        </Grid>
                                        <TextBlock Text="{h:Translate Optimize_Console_Header}" FontSize="13" FontWeight="SemiBold" Foreground="#D0E0F0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Ellipse x:Name="ConsoleStatusDot" Width="8" Height="8" Fill="{StaticResource App.Brush.Status.Idle}" Margin="0,0,8,0">
                                            <Ellipse.Effect>
                                                <DropShadowEffect x:Name="ConsoleStatusGlow" BlurRadius="6" ShadowDepth="0" Color="#607D8B" Opacity="0.5"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock x:Name="ConsoleStatusText" Text="{h:Translate Optimize_Console_Status_Idle}" FontSize="11" Foreground="#708898"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="4,0">
                                <TextBox x:Name="TerminalBox" 
                                         Margin="12,10" IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         Background="Transparent" Foreground="#A0B8D0"
                                         FontFamily="Cascadia Code, Consolas" FontSize="11"
                                         BorderThickness="0" CaretBrush="{StaticResource App.Brush.Gold}"
                                         VerticalAlignment="Top"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </h:ShadowCard>
            </Grid>

            <Border x:Name="StatsFooter" Grid.Row="2" 
                    Visibility="Collapsed" Opacity="0"
                    Margin="0,20,0,0"
                    Style="{StaticResource App.Style.GlassCard}"
                    Padding="20,14">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="StatsTranslate" Y="20"/>
                </Border.RenderTransform>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE7F4;" 
                                   Style="{StaticResource App.Style.Glyph}"
                                   FontSize="20" Foreground="{StaticResource App.Brush.DeepSkyBlue}" 
                                   HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock x:Name="StatMemory" Text="0 MB" 
                                   FontSize="16" FontWeight="Bold" Foreground="White" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{h:Translate Optimize_Stat_Memory}" FontSize="11" Foreground="#7090A8" 
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                    
                    <Rectangle Grid.Column="1" Width="1" Fill="#20FFFFFF" Margin="0,4"/>
                    
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE74D;" 
                                   Style="{StaticResource App.Style.Glyph}"
                                   FontSize="20" Foreground="#7ED321" 
                                   HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock x:Name="StatStorage" Text="0 MB" 
                                   FontSize="16" FontWeight="Bold" Foreground="White" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{h:Translate Optimize_Stat_Storage}" FontSize="11" Foreground="#7090A8" 
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                    
                    <Rectangle Grid.Column="3" Width="1" Fill="#20FFFFFF" Margin="0,4"/>
                    
                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE71E;" 
                                   Style="{StaticResource App.Style.Glyph}"
                                   FontSize="20" Foreground="#F5A623" 
                                   HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock x:Name="StatApps" Text="0" 
                                   FontSize="16" FontWeight="Bold" Foreground="White" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{h:Translate Optimize_Stat_AppsStopped}" FontSize="11" Foreground="#7090A8" 
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                    
                    <Rectangle Grid.Column="5" Width="1" Fill="#20FFFFFF" Margin="0,4"/>
                    
                    <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                        <TextBlock x:Name="StatStatusIcon" Text="&#xE73E;" 
                                   Style="{StaticResource App.Style.Glyph}"
                                   FontSize="20" Foreground="{StaticResource App.Brush.Gold}" 
                                   HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock x:Name="StatStatus" Text="Ready" 
                                   FontSize="16" FontWeight="Bold" Foreground="White" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{h:Translate Optimize_Stat_Status}" FontSize="11" Foreground="#7090A8" 
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="DeviceStatusCard"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.5"
                                     BeginTime="0:0:0.1">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="StatusCardTranslate"
                                     Storyboard.TargetProperty="Y"
                                     From="-30" To="0" Duration="0:0:0.5"
                                     BeginTime="0:0:0.1">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    
                    <DoubleAnimation Storyboard.TargetName="CenterCard"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.5"
                                     BeginTime="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="CardScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="0.85" To="1" Duration="0:0:0.5"
                                     BeginTime="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <BackEase EasingMode="EaseOut" Amplitude="0.25"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="CardScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="0.85" To="1" Duration="0:0:0.5"
                                     BeginTime="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <BackEase EasingMode="EaseOut" Amplitude="0.25"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="CardTranslate"
                                     Storyboard.TargetProperty="Y"
                                     From="20" To="0" Duration="0:0:0.5"
                                     BeginTime="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    
                    <DoubleAnimation Storyboard.TargetName="ConsoleCard"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.5"
                                     BeginTime="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ConsoleScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="0.9" To="1" Duration="0:0:0.5"
                                     BeginTime="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ConsoleScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="0.9" To="1" Duration="0:0:0.5"
                                     BeginTime="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ConsoleTranslate"
                                     Storyboard.TargetProperty="X"
                                     From="30" To="0" Duration="0:0:0.5"
                                     BeginTime="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    
                    <DoubleAnimation Storyboard.TargetName="RingRotation"
                                     Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:8"
                                     RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
