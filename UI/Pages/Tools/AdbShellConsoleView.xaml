<UserControl x:Class="ZephyrsElixir.UI.Pages.AdbShellConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:ZephyrsElixir.UI.Helpers"
             Background="Transparent">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="Console.Brush.Accent" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00D68F" Offset="0"/>
            <GradientStop Color="#00B377" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="Console.Effect.Glow" Color="#00D68F" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>

        <Style x:Key="Console.Style.CategoryHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#7A93B5"/>
            <Setter Property="Margin" Value="2,0,0,10"/>
        </Style>

        <!-- "New tab" pill: light glyph, subtle accent on hover (never black). -->
        <Style x:Key="Console.Style.TabAction" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#9FB4CC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                BorderThickness="1" BorderBrush="Transparent">
                            <TextBlock x:Name="glyph" Text="{TemplateBinding Content}"
                                       FontFamily="Segoe MDL2 Assets" FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E00BFFF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4A00BFFF"/>
                                <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource App.Brush.DeepSkyBlue}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3300BFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab close affordance: dim by default, turns red on hover. -->
        <Style x:Key="Console.Style.TabClose" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="#8093A8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9">
                            <TextBlock x:Name="glyph" Text="{TemplateBinding Content}"
                                       FontFamily="Segoe MDL2 Assets" FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E0444F"/>
                                <Setter TargetName="glyph" Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B92A1B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Monospace command input, inherits glass look from the central style. -->
        <Style x:Key="Console.Style.Input" TargetType="TextBox" BasedOn="{StaticResource App.Style.TextBox.Glass}">
            <Setter Property="FontFamily" Value="{StaticResource AppMonospaceFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style x:Key="Console.Style.SmallInput" TargetType="TextBox" BasedOn="{StaticResource App.Style.TextBox.Glass}">
            <Setter Property="FontFamily" Value="{StaticResource AppMonospaceFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <!-- Editable tab header + close button -->
        <Style x:Key="Console.Style.TabItem" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="bd" MinWidth="94" Height="34" Margin="0,0,6,0" CornerRadius="8,8,0,0"
                                    Background="#0FFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1,1,1,0">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" Margin="12,0"/>
                            </Border>
                            <Border x:Name="accent" Height="2" VerticalAlignment="Bottom" Margin="3,0,9,0"
                                    CornerRadius="1" Background="{StaticResource App.Brush.DeepSkyBlue}" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#26FFFFFF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3A6FA8CF"/>
                                <Setter TargetName="accent" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabControl reduced to its header strip; output is hosted in a shared RichTextBox below. -->
        <Style x:Key="Console.Style.TabStrip" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource Console.Style.TabItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <TabPanel IsItemsHost="True" Background="Transparent" Margin="0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid MinWidth="52" MaxWidth="150" Margin="0,0,8,0">
                                <TextBlock x:Name="TabLabel" Text="{Binding Title}"
                                           Foreground="#E8EEF6" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           MouseLeftButtonDown="OnTabLabelMouseDown" ToolTip="Double-click to rename"/>
                                <TextBox x:Name="TabEditor" Visibility="Collapsed"
                                         Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#33000000" BorderThickness="0" Padding="2,0"
                                         Foreground="White" FontSize="13" FontWeight="SemiBold" CaretBrush="White"
                                         VerticalContentAlignment="Center"
                                         KeyDown="OnTabEditorKeyDown" LostFocus="OnTabEditorCommit"/>
                            </Grid>
                            <Button Content="&#xE8BB;" Style="{StaticResource Console.Style.TabClose}"
                                    Click="OnCloseTabClick" Tag="{Binding}" ToolTip="Close tab"/>
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Autocomplete suggestion item (ListBox container) -->
        <Style x:Key="Console.Style.AutoItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#28FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4800BFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Snippet list entry -->
        <Style x:Key="Console.Style.SnippetButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#12FFFFFF" BorderBrush="#22FFFFFF"
                                BorderThickness="1" CornerRadius="8" Padding="10,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource App.Brush.DeepSkyBlue}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <h:ShadowCard Grid.Row="0" Padding="24" ShadowEffect="{StaticResource App.Effect.PageShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <h:GlowIcon Size="48" CornerRadius="24"
                            Background="{StaticResource Console.Brush.Accent}"
                            GlowEffect="{StaticResource Console.Effect.Glow}">
                        <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </h:GlowIcon>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{h:Translate Tools_AdbConsole_Title}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{h:Translate Tools_AdbConsole_Description}"
                                   Foreground="{StaticResource App.Brush.Steel}" FontSize="13" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource App.Style.Button.Inline}" Tag="&#xE74E;" Content="Export"
                            Click="OnExportClick" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource App.Style.Button.Inline}" Tag="&#xE894;" Content="Clear"
                            Click="OnClearClick" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource App.Style.WindowControl.Close}" Click="OnCloseClick" ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </h:ShadowCard>

        <!-- Body -->
        <h:ShadowCard Grid.Row="2" Padding="0" ShadowEffect="{StaticResource App.Effect.PageShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- Console column -->
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Tab strip + add button on a shared baseline bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" Background="#1FFFFFFF"/>
                        <TabControl x:Name="Tabs" Grid.Column="0" Style="{StaticResource Console.Style.TabStrip}"
                                    ItemsSource="{Binding Sessions}" SelectionChanged="OnTabSelectionChanged"/>
                        <Button Grid.Column="1" Content="&#xE710;" Style="{StaticResource Console.Style.TabAction}"
                                Click="OnAddTabClick" ToolTip="New tab" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                    </Grid>

                    <!-- Output -->
                    <Border Grid.Row="1" CornerRadius="10" Background="#2607101E" BorderBrush="#1FFFFFFF" BorderThickness="1">
                        <Grid>
                            <RichTextBox x:Name="OutputBox" IsReadOnly="True" IsDocumentEnabled="True"
                                         Background="Transparent" Foreground="#E0E0E0" BorderThickness="0"
                                         FontFamily="{StaticResource AppMonospaceFont}" FontSize="13"
                                         Padding="14,12" SelectionBrush="#6600BFFF"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                            <StackPanel x:Name="EmptyHint" IsHitTestVisible="False"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="44"
                                           Foreground="#3F6E94" HorizontalAlignment="Center"/>
                                <TextBlock Text="Interactive ADB shell" Foreground="#8AA6C2" FontSize="15"
                                           FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                                <TextBlock Text="Type a command below, or pick a snippet on the right"
                                           Foreground="#5E7794" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Input + autocomplete -->
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <TextBox x:Name="InputBox" Style="{StaticResource Console.Style.Input}" Padding="38,0,12,0"
                                 Tag="Type an adb shell command — Enter to run, Tab to autocomplete, &#8593;/&#8595; for history"
                                 PreviewKeyDown="OnInputPreviewKeyDown"/>
                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{StaticResource App.Brush.DeepSkyBlue}" IsHitTestVisible="False"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="17,0,0,0"/>
                        <Popup x:Name="AutoPopup" PlacementTarget="{Binding ElementName=InputBox}" Placement="Top"
                               AllowsTransparency="True" StaysOpen="False" MinWidth="240">
                            <Border Background="#F01E2D4B" BorderBrush="{StaticResource App.Brush.DeepSkyBlue}"
                                    BorderThickness="1" CornerRadius="8" Margin="0,0,0,6">
                                <ListBox x:Name="AutoList" Background="Transparent" BorderThickness="0" MaxHeight="220"
                                         Foreground="White" FontFamily="{StaticResource AppMonospaceFont}" FontSize="13"
                                         ItemContainerStyle="{StaticResource Console.Style.AutoItem}"
                                         PreviewMouseLeftButtonUp="OnAutoListClick"/>
                            </Border>
                        </Popup>
                    </Grid>
                </Grid>

                <!-- Snippet panel -->
                <Border Grid.Column="1" Background="#08FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1,0,0,0">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="SNIPPETS" Style="{StaticResource Console.Style.CategoryHeader}"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Snippets}" Margin="0,0,12,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Console.Style.SnippetButton}"
                                                Click="OnSnippetClick" Tag="{Binding Command}"
                                                ToolTip="{Binding Command}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Foreground="White"
                                                           FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Command}" Foreground="#80FFFFFF"
                                                           FontFamily="{StaticResource AppMonospaceFont}" FontSize="11"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Margin="0,16,0,0">
                            <Border Height="1" Background="#15FFFFFF" Margin="0,0,0,16"/>
                            <TextBlock Text="ADD SNIPPET" Style="{StaticResource Console.Style.CategoryHeader}"/>
                            <TextBox x:Name="SnippetNameBox" Style="{StaticResource Console.Style.SmallInput}"
                                     Tag="Name" Margin="0,0,0,6"/>
                            <TextBox x:Name="SnippetCmdBox" Style="{StaticResource Console.Style.SmallInput}"
                                     Tag="adb command" Margin="0,0,0,8"/>
                            <Button Style="{StaticResource App.Style.Button.Inline}" Tag="&#xE710;" Content="Save snippet"
                                    Click="OnAddSnippetClick" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </h:ShadowCard>
    </Grid>
</UserControl>
