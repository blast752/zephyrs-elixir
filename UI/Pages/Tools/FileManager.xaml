<UserControl x:Class="ZephyrsElixir.UI.Pages.FileManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:ZephyrsElixir.UI.Helpers"
             xmlns:fm="clr-namespace:ZephyrsElixir.UI.Pages"
             Background="{StaticResource App.Brush.WindowBg}"
             AllowDrop="True"
             DragEnter="OnGridDragOver"
             DragOver="OnGridDragOver"
             DragLeave="OnGridDragLeave"
             Drop="OnGridDrop">

    <UserControl.InputBindings>
        <KeyBinding Key="F5"                 Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="F2"                 Command="{Binding RenameCommand}"/>
        <KeyBinding Key="F3"                 Command="{Binding PreviewSelectionCommand}"/>
        <KeyBinding Key="Delete"             Command="{Binding DeleteCommand}"/>
        <KeyBinding Key="Back"               Command="{Binding GoUpCommand}"/>
        <KeyBinding Key="Enter"              Command="{Binding OpenSelectionCommand}"/>
        <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CopySelectionCommand}"/>
        <KeyBinding Key="X" Modifiers="Ctrl" Command="{Binding CutSelectionCommand}"/>
        <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding PasteCommand}"/>
        <KeyBinding Key="L" Modifiers="Ctrl" Command="{Binding GoToInputPathCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <SolidColorBrush x:Key="FileManager.Brush.AccentSoft" Color="#2500BFFF"/>

        <DropShadowEffect x:Key="FileManager.Effect.AccentGlow"
                          Color="{StaticResource App.Color.DeepSkyBlue}"
                          BlurRadius="22" ShadowDepth="0" Opacity="0.65"/>
        <DropShadowEffect x:Key="FileManager.Effect.ModalGlow"
                          Color="{StaticResource App.Color.DeepSkyBlue}"
                          BlurRadius="40" ShadowDepth="0" Opacity="0.45"/>

        <Style x:Key="FileManager.Style.SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource App.Brush.Steel.Dim}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="FileManager.Style.CellText.Plain" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource App.Brush.Steel.Dim}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="FileManager.Style.CellText.Mono" TargetType="TextBlock" BasedOn="{StaticResource FileManager.Style.CellText.Plain}">
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas"/>
        </Style>

        <Style x:Key="FileManager.Style.CellText.Strong" TargetType="TextBlock" BasedOn="{StaticResource FileManager.Style.CellText.Mono}">
            <Setter Property="Foreground" Value="#B8C8DC"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="FileManager.Style.UpFolderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0,12,0"/>
            <Setter Property="Foreground" Value="#D0D8E8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="iconBadge"
                                        Width="22" Height="22" CornerRadius="11"
                                        Background="{StaticResource App.Brush.IconCircle}">
                                    <h:Icon Kind="arrow-up" Size="14" x:Name="arrow" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="label" Grid.Column="1"
                                           Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#22FFFFFF"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource App.Brush.DeepSkyBlue}"/>
                                <Setter TargetName="label" Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#35FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource App.Brush.DeepSkyBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FileManager.Style.ToolbarButton" TargetType="Button" BasedOn="{StaticResource App.Style.Button.Inline}">
            <Setter Property="Margin" Value="3"/>
        </Style>

        <Style x:Key="FileManager.Style.ToolbarButton.Destructive" TargetType="Button" BasedOn="{StaticResource App.Style.Button.Inline.Destructive}">
            <Setter Property="Margin" Value="3"/>
        </Style>

        <Style x:Key="FileManager.Style.ToolbarSeparator" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="Margin" Value="6,0"/>
        </Style>

        <Style x:Key="FileManager.Style.TopProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="3"/>
            <Setter Property="IsIndeterminate" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource App.Brush.DeepSkyBlue}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="FileManager.Style.BadgeGlyph" TargetType="{x:Type h:Icon}">
            <Setter Property="Size" Value="16"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="FileManager.Style.HeaderToggle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource App.Brush.Steel.Dim}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="0,2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#15FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource App.Brush.DeepSkyBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FileManager.Style.Crumb" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#B8C8DC"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#15FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FileManager.Style.BookmarkTile" TargetType="Button">
            <Setter Property="Background" Value="#10FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource App.Brush.Glass.Background}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#22FFFFFF"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource App.Brush.DeepSkyBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FileManager.Style.TreeItem" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="row" Background="Transparent" CornerRadius="6" Padding="2,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="expander"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  ClickMode="Press" Focusable="False">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" Width="18" Height="18">
                                                    <h:Icon Kind="chevron-right" Size="11" x:Name="chev" Foreground="{StaticResource App.Brush.Steel.Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="chev" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="90"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter TargetName="chev" Property="Foreground" Value="{StaticResource App.Brush.DeepSkyBlue}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="items" Grid.Row="1" Margin="20,0,0,0" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="items" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="#10FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{StaticResource FileManager.Brush.AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FileManager.Style.TreeView" TargetType="TreeView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="FileManager.Style.GridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource App.Brush.Steel.Dim}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="BorderBrush" Value="#15FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FileManager.Style.GridCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FileManager.Style.GridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#08FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource FileManager.Brush.AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FileManager.Style.Grid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="RowHeight" Value="46"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="Transparent"/>
        </Style>

        <Style x:Key="FileManager.Style.MenuItem" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource FileManager.Brush.AccentSoft}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#60FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FileManager.Style.MenuSep" TargetType="Separator">
            <Setter Property="Margin" Value="4,4"/>
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FileManager.Style.ContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#FF1A2747"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type fm:TreeNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Grid Width="18" Height="18" VerticalAlignment="Center">
                    <Image Source="{Binding NodeImage}" Stretch="Uniform"/>
                    <h:Icon Kind="{Binding Icon}" Size="15" Foreground="{StaticResource App.Brush.DeepSkyBlue}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNodeImage, Converter={StaticResource App.Converter.InverseBoolToVisibility}}"/>
                </Grid>
                <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="White" FontSize="13"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <h:ShadowCard Padding="22,18" ShadowEffect="{StaticResource App.Effect.PageShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Style="{StaticResource App.Style.Button.Inline}"
                            Content="{h:Translate FileManager_Button_Back}" Tag="arrow-left"
                            Command="{Binding CloseCommand}"/>

                    <h:GlowIcon Grid.Column="2" Size="48" CornerRadius="14"
                                Background="{StaticResource App.Brush.IconCircle}"
                                GlowEffect="{StaticResource FileManager.Effect.AccentGlow}">
                        <h:Icon Kind="folder-open" Size="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </h:GlowIcon>

                    <StackPanel Grid.Column="3" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{h:Translate FileManager_Header_Title}" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <ItemsControl ItemsSource="{Binding Breadcrumbs}" Margin="0,4,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource FileManager.Style.Crumb}"
                                                Content="{Binding Label}"
                                                Tag="{Binding FullPath}"
                                                Click="OnPathChipClick"/>
                                        <TextBlock Text="/" Foreground="#4C5C78" Margin="0,0,0,0"
                                                   VerticalAlignment="Center" FontSize="12"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource App.Style.Button.Inline}" Margin="0,0,6,0"
                                Content="{h:Translate FileManager_Button_Home}" Tag="home"
                                Command="{Binding GoHomeCommand}"/>
                        <Button Style="{StaticResource App.Style.Button.Inline}"
                                Content="{h:Translate FileManager_Button_Refresh}" Tag="refresh"
                                Command="{Binding RefreshCommand}"/>
                    </StackPanel>
                </Grid>
            </h:ShadowCard>

            <h:ShadowCard Grid.Row="2" Padding="0" ShadowEffect="{StaticResource App.Effect.PageShadow}">
                <Border CornerRadius="14" ClipToBounds="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border BorderBrush="#18FFFFFF" BorderThickness="0,0,1,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Margin="20,20,20,8">
                                    <TextBlock Text="{h:Translate FileManager_Section_QuickAccess}"
                                               Style="{StaticResource FileManager.Style.SectionLabel}"/>
                                    <ItemsControl ItemsSource="{Binding Bookmarks}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource FileManager.Style.BookmarkTile}"
                                                        Tag="{Binding Path}"
                                                        Click="OnPathChipClick"
                                                        ToolTip="{Binding Path}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="32" Height="32" CornerRadius="8"
                                                                Background="{Binding Brush}">
                                                            <h:Icon Kind="{Binding Icon}"
                                                                    Style="{StaticResource FileManager.Style.BadgeGlyph}"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                                       Foreground="White"/>
                                                            <TextBlock Text="{Binding Path}" FontSize="10"
                                                                       Foreground="#6E7F99"
                                                                       FontFamily="Cascadia Code, Consolas"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Border Grid.Row="1" Height="1" Margin="20,8" Background="#15FFFFFF"/>

                                <Grid Grid.Row="2" Margin="20,0,20,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{h:Translate FileManager_Section_Locations}"
                                               Style="{StaticResource FileManager.Style.SectionLabel}"
                                               Margin="0,4,0,8"/>
                                    <Border Grid.Row="1" Background="#08000000" CornerRadius="10"
                                            BorderBrush="#15FFFFFF" BorderThickness="1">
                                        <TreeView
                                                  ItemsSource="{Binding TreeRoots}"
                                                  Style="{StaticResource FileManager.Style.TreeView}"
                                                  ItemContainerStyle="{StaticResource FileManager.Style.TreeItem}"
                                                  SelectedItemChanged="OnTreeSelectionChanged"
                                                  TreeViewItem.Expanded="OnTreeItemExpanded"/>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="3" Margin="20,0,20,18" Padding="14,12"
                                        Background="#08FFFFFF" CornerRadius="10"
                                        BorderBrush="#18FFFFFF" BorderThickness="1">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{h:Translate FileManager_Storage_Title}"
                                                       Style="{StaticResource FileManager.Style.SectionLabel}"/>
                                            <ProgressBar Grid.Column="1" Width="40" Height="3"
                                                         Style="{StaticResource FileManager.Style.TopProgress}"
                                                         Visibility="{Binding IsStorageLoading, Converter={StaticResource App.Converter.BooleanToVisibility}}"/>
                                        </Grid>

                                        <StackPanel Visibility="{Binding IsStorageAvailable, Converter={StaticResource App.Converter.BooleanToVisibility}}">
                                            <TextBlock Text="{Binding StorageSummaryText}"
                                                       Foreground="#B8C8DC" FontSize="12"
                                                       FontFamily="Cascadia Code, Consolas"
                                                       Margin="0,6,0,8"/>
                                            <Border Height="10" CornerRadius="5" ClipToBounds="True"
                                                    Background="{Binding StorageBarBrush}"
                                                    BorderBrush="#18FFFFFF" BorderThickness="1"/>
                                            <ItemsControl ItemsSource="{Binding StorageSegments}" Margin="0,10,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                                            <Border Width="8" Height="8" CornerRadius="2"
                                                                    VerticalAlignment="Center"
                                                                    Background="{Binding ColorBrush}"/>
                                                            <TextBlock Text="{Binding Label}" Margin="6,0,4,0"
                                                                       Foreground="#D0D8E8" FontSize="11"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding SizeDisplay}"
                                                                       Foreground="{StaticResource App.Brush.Steel.Dim}" FontSize="11"
                                                                       FontFamily="Cascadia Code, Consolas"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <TextBlock Text="{h:Translate FileManager_Storage_Unavailable}"
                                                   Foreground="{StaticResource App.Brush.Steel.Dim}" FontSize="11" Margin="0,6,0,0"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsStorageAvailable}" Value="False"/>
                                                                <Condition Binding="{Binding IsStorageLoading}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Padding="14,12" Background="#06FFFFFF"
                                    BorderBrush="#18FFFFFF" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button
                                            Style="{StaticResource FileManager.Style.UpFolderButton}"
                                            Content="{h:Translate FileManager_Button_Up}"
                                            Command="{Binding GoUpCommand}"
                                            ToolTip="{h:Translate FileManager_Button_Up}"
                                            AutomationProperties.Name="{h:Translate FileManager_Button_Up}"/>
                                    <TextBox x:Name="PathBar" Grid.Column="2"
                                             Style="{StaticResource App.Style.TextBox.Glass}"
                                             Height="38"
                                             FontFamily="Cascadia Code, Consolas"
                                             FontSize="13"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding PathInput, UpdateSourceTrigger=PropertyChanged}"
                                             KeyDown="OnPathBarKeyDown"
                                             ToolTip="{h:Translate FileManager_PathBar_Tooltip}"/>
                                    <Button Grid.Column="4"
                                            Style="{StaticResource App.Style.Button.Inline}"
                                            Content="{h:Translate FileManager_Button_Go}" Tag="arrow-right"
                                            Height="38"
                                            Command="{Binding GoToInputPathCommand}"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Padding="20,8" Background="#04FFFFFF"
                                    BorderBrush="#18FFFFFF" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding StatusMessage}"
                                               Foreground="#A0B8C8" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ClipboardSummary}"
                                               Foreground="{StaticResource App.Brush.DeepSkyBlue}" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="0,0,14,0"
                                               Visibility="{Binding HasClipboard, Converter={StaticResource App.Converter.BooleanToVisibility}}"/>
                                    <Grid Grid.Column="2" Width="210">
                                        <TextBox
                                                 Style="{StaticResource App.Style.TextBox.Glass}"
                                                 Height="30" Padding="28,0,10,0" FontSize="12"
                                                 VerticalContentAlignment="Center"
                                                 Tag="{h:Translate FileManager_Filter_Placeholder}"
                                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                                 KeyDown="OnFilterKeyDown"/>
                                        <h:Icon Kind="search" Size="13" Foreground="{StaticResource App.Brush.Steel.Dim}" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2">
                                <DataGrid x:Name="EntriesGrid"
                                          ItemsSource="{Binding Entries}"
                                          Style="{StaticResource FileManager.Style.Grid}"
                                          CellStyle="{StaticResource FileManager.Style.GridCell}"
                                          RowStyle="{StaticResource FileManager.Style.GridRow}"
                                          ColumnHeaderStyle="{StaticResource FileManager.Style.GridColumnHeader}"
                                          AllowDrop="True"
                                          MouseDoubleClick="OnGridDoubleClick"
                                          SelectionChanged="OnGridSelectionChanged"
                                          PreviewKeyDown="OnGridPreviewKeyDown"
                                          PreviewMouseLeftButtonDown="OnGridMouseDown"
                                          PreviewMouseMove="OnGridMouseMove"
                                          DragEnter="OnGridDragOver"
                                          DragOver="OnGridDragOver"
                                          DragLeave="OnGridDragLeave"
                                          Drop="OnGridDrop">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="" Width="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid Width="34" Height="34"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center">
                                                        <Border CornerRadius="8"
                                                                Background="{Binding TypeBrush}"
                                                                Visibility="{Binding HasTypeImage, Converter={StaticResource App.Converter.InverseBoolToVisibility}}">
                                                            <h:Icon Kind="{Binding TypeIcon}"
                                                                    Style="{StaticResource FileManager.Style.BadgeGlyph}"/>
                                                        </Border>
                                                        <Image Source="{Binding TypeImage}" Stretch="Uniform" Margin="4"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="{h:Translate FileManager_Column_Name}" Width="1.5*" MinWidth="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal"
                                                                ToolTip="{Binding Name}">
                                                        <TextBlock Text="{Binding Name}" Foreground="White"
                                                                   FontSize="13" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding SymlinkSuffix}"
                                                                   Foreground="{StaticResource App.Brush.Steel.Dim}" FontSize="11"
                                                                   FontStyle="Italic" Margin="6,0,0,0"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="{h:Translate FileManager_Column_Size}"
                                                            Binding="{Binding SizeDisplay}" Width="100"
                                                            ElementStyle="{StaticResource FileManager.Style.CellText.Strong}"/>
                                        <DataGridTemplateColumn Width="2*" MinWidth="170">
                                            <DataGridTemplateColumn.HeaderTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource FileManager.Style.HeaderToggle}"
                                                            Command="{Binding DataContext.CyclePermissionsDisplayCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                            ToolTip="{h:Translate FileManager_Permissions_Tooltip}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding DataContext.PermissionsHeaderText, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                       FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                       VerticalAlignment="Center"/>
                                                            <h:Icon Kind="volume" Size="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.HeaderTemplate>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Style="{StaticResource FileManager.Style.CellText.Mono}"
                                                               ToolTipService.ShowDuration="20000">
                                                        <TextBlock.ToolTip>
                                                            <ToolTip Content="{Binding RelativeSource={RelativeSource Self}, Path=PlacementTarget.Text}"/>
                                                        </TextBlock.ToolTip>
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{x:Static fm:PermissionsDisplayConverter.Instance}">
                                                                <Binding Path="Permissions"/>
                                                                <Binding Path="DataContext.PermissionsDisplayMode"
                                                                         RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="{h:Translate FileManager_Column_Owner}" Width="150">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding OwnerDisplay}"
                                                               Style="{StaticResource FileManager.Style.CellText.Plain}"
                                                               ToolTip="{Binding OwnerDisplay}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="{h:Translate FileManager_Column_Modified}"
                                                            Binding="{Binding ModifiedDisplay}" Width="150"
                                                            ElementStyle="{StaticResource FileManager.Style.CellText.Mono}"/>
                                    </DataGrid.Columns>
                                    <DataGrid.ContextMenu>
                                        <ContextMenu Style="{StaticResource FileManager.Style.ContextMenu}">
                                            <MenuItem Header="{h:Translate FileManager_Menu_Open}"
                                                      Command="{Binding OpenSelectionCommand}"
                                                      Style="{StaticResource FileManager.Style.MenuItem}"/>
                                            <MenuItem Header="{h:Translate FileManager_Menu_RenameEllipsis}"
                                                      Command="{Binding RenameCommand}"
                                                      Style="{StaticResource FileManager.Style.MenuItem}"/>
                                            <Separator Style="{StaticResource FileManager.Style.MenuSep}"/>
                                            <MenuItem Header="{h:Translate FileManager_Button_Cut}"
                                                      Command="{Binding CutSelectionCommand}"
                                                      Style="{StaticResource FileManager.Style.MenuItem}"/>
                                            <MenuItem Header="{h:Translate FileManager_Button_Copy}"
                                                      Command="{Binding CopySelectionCommand}"
                                                      Style="{StaticResource FileManager.Style.MenuItem}"/>
                                            <MenuItem Header="{h:Translate FileManager_Button_Paste}"
                                                      Command="{Binding PasteCommand}"
                                                      Style="{StaticResource FileManager.Style.MenuItem}"/>
                                            <Separator Style="{StaticResource FileManager.Style.MenuSep}"/>
                                            <MenuItem Header="{h:Translate FileManager_Button_Delete}"
                                                      Command="{Binding DeleteCommand}"
                                                      Style="{StaticResource FileManager.Style.MenuItem}"/>
                                            <MenuItem Header="{h:Translate FileManager_Menu_ChmodEllipsis}"
                                                      Command="{Binding ChangePermissionsCommand}"
                                                      Style="{StaticResource FileManager.Style.MenuItem}"/>
                                            <Separator Style="{StaticResource FileManager.Style.MenuSep}"/>
                                            <MenuItem Header="{h:Translate FileManager_Menu_PullEllipsis}"
                                                      Command="{Binding PullToFolderCommand}"
                                                      Style="{StaticResource FileManager.Style.MenuItem}"/>
                                            <MenuItem Header="{h:Translate FileManager_Menu_Properties}"
                                                      Command="{Binding ShowPropertiesCommand}"
                                                      Style="{StaticResource FileManager.Style.MenuItem}"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                </DataGrid>

                                <Border IsHitTestVisible="False"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasEntries, Converter={StaticResource App.Converter.InverseBoolToVisibility}}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                                        <Border Width="72" Height="72" CornerRadius="20"
                                                Background="#15FFFFFF" HorizontalAlignment="Center">
                                            <h:Icon Kind="warning" Size="34" Foreground="{StaticResource App.Brush.Steel.Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding EmptyStateMessage}"
                                                   Foreground="#A0B8C8" FontSize="14"
                                                   HorizontalAlignment="Center" Margin="0,16,0,0"
                                                   TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border IsHitTestVisible="False" VerticalAlignment="Top" Height="3"
                                        Visibility="{Binding IsLoading, Converter={StaticResource App.Converter.BooleanToVisibility}}">
                                    <ProgressBar Style="{StaticResource FileManager.Style.TopProgress}"/>
                                </Border>
                            </Grid>
                        </Grid>

                        <Border Grid.Column="2" Width="340" MinWidth="280" MaxWidth="420"
                                BorderBrush="#18FFFFFF" BorderThickness="1,0,0,0"
                                Visibility="{Binding IsPreviewOpen, Converter={StaticResource App.Converter.BooleanToVisibility}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Margin="16,14,12,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{h:Translate FileManager_Section_Preview}"
                                                   Style="{StaticResource FileManager.Style.SectionLabel}"/>
                                        <TextBlock Text="{Binding PreviewName}" Foreground="White"
                                                   FontWeight="SemiBold" FontSize="14" Margin="0,4,0,2"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding PreviewName}"/>
                                        <TextBlock Text="{Binding PreviewSubtitle}" Foreground="{StaticResource App.Brush.Steel.Dim}"
                                                   FontSize="11" FontFamily="Cascadia Code, Consolas"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource App.Style.Button.IconOnly}"
                                            Command="{Binding ClosePreviewCommand}"
                                            VerticalAlignment="Top">
                                        <h:Icon Kind="close" Size="14"/>
                                    </Button>
                                </Grid>

                                <Border Grid.Row="1" Margin="16,0,16,16"
                                        Background="#06FFFFFF" CornerRadius="10"
                                        BorderBrush="#18FFFFFF" BorderThickness="1">
                                    <Grid>
                                        <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="8"
                                               Visibility="{Binding IsImagePreview, Converter={StaticResource App.Converter.BooleanToVisibility}}"/>

                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                      Padding="10"
                                                      Visibility="{Binding IsTextPreview, Converter={StaticResource App.Converter.BooleanToVisibility}}">
                                            <TextBox Text="{Binding PreviewText, Mode=OneWay}"
                                                     IsReadOnly="True"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="#D8E0EC"
                                                     FontFamily="Cascadia Code, Consolas"
                                                     FontSize="12"
                                                     TextWrapping="NoWrap"/>
                                        </ScrollViewer>

                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Visibility="{Binding HasPreviewError, Converter={StaticResource App.Converter.BooleanToVisibility}}">
                                            <h:Icon Kind="warning" Size="34" Foreground="#FFA1A1" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding PreviewError}" Foreground="#FFA1A1"
                                                       FontSize="12" TextWrapping="Wrap" MaxWidth="240"
                                                       HorizontalAlignment="Center" TextAlignment="Center"
                                                       Margin="0,10,0,0"/>
                                        </StackPanel>

                                        <Border VerticalAlignment="Top" Height="3"
                                                Visibility="{Binding IsPreviewLoading, Converter={StaticResource App.Converter.BooleanToVisibility}}">
                                            <ProgressBar Style="{StaticResource FileManager.Style.TopProgress}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </h:ShadowCard>

            <h:ShadowCard Grid.Row="4" Padding="18,14" ShadowEffect="{StaticResource App.Effect.PageShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" MinWidth="220"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="10"
                                Background="{Binding ConnectionStatusBrush}">
                            <h:Icon Kind="wireless" Size="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ConnectionStatusText}" Foreground="White"
                                       FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DeviceSerialDisplay}" Foreground="{StaticResource App.Brush.Steel.Dim}" FontSize="11"
                                       FontFamily="Cascadia Code, Consolas" TextTrimming="CharacterEllipsis"
                                       MaxWidth="280"
                                       ToolTip="{Binding DeviceSerialDisplay}"/>
                        </StackPanel>
                    </StackPanel>

                    <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <Button Style="{StaticResource FileManager.Style.ToolbarButton}"
                                Content="{h:Translate FileManager_Button_NewFolder}" Tag="document-add"
                                Command="{Binding CreateDirectoryCommand}"/>
                        <Button Style="{StaticResource FileManager.Style.ToolbarButton}"
                                Content="{h:Translate FileManager_Button_Push}" Tag="upload"
                                Command="{Binding UploadCommand}"/>
                        <Button Style="{StaticResource FileManager.Style.ToolbarButton}"
                                Content="{h:Translate FileManager_Button_Pull}" Tag="download"
                                Command="{Binding PullToFolderCommand}"/>
                        <Border Style="{StaticResource FileManager.Style.ToolbarSeparator}"/>
                        <Button Style="{StaticResource FileManager.Style.ToolbarButton}"
                                Content="{h:Translate FileManager_Button_Cut}" Tag="cut"
                                Command="{Binding CutSelectionCommand}"/>
                        <Button Style="{StaticResource FileManager.Style.ToolbarButton}"
                                Content="{h:Translate FileManager_Button_Copy}" Tag="copy"
                                Command="{Binding CopySelectionCommand}"/>
                        <Button Style="{StaticResource FileManager.Style.ToolbarButton}"
                                Content="{h:Translate FileManager_Button_Paste}" Tag="paste"
                                Command="{Binding PasteCommand}"/>
                        <Border Style="{StaticResource FileManager.Style.ToolbarSeparator}"/>
                        <Button Style="{StaticResource FileManager.Style.ToolbarButton}"
                                Content="{h:Translate FileManager_Button_Rename}" Tag="rename"
                                Command="{Binding RenameCommand}"/>
                        <Button Style="{StaticResource FileManager.Style.ToolbarButton}"
                                Content="{h:Translate FileManager_Button_Chmod}" Tag="check"
                                Command="{Binding ChangePermissionsCommand}"/>
                        <Button Style="{StaticResource FileManager.Style.ToolbarButton.Destructive}"
                                Content="{h:Translate FileManager_Button_Delete}" Tag="delete"
                                Command="{Binding DeleteCommand}"/>
                    </WrapPanel>

                    <Border Grid.Column="2" Margin="16,0,0,0" MaxWidth="240"
                            Visibility="{Binding HasActiveTransfers, Converter={StaticResource App.Converter.BooleanToVisibility}}"
                            Background="#10FFFFFF" CornerRadius="10" BorderBrush="{StaticResource App.Brush.Glass.Background}" BorderThickness="1"
                            Padding="12,6" ToolTipService.ShowDuration="30000">
                        <Border.ToolTip>
                            <ItemsControl ItemsSource="{Binding Transfers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <Border Width="8" Height="8" CornerRadius="4"
                                                    Background="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DirectionLabel}" Foreground="#9FB4CC"
                                                       FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="White"
                                                       FontSize="11" Margin="7,0,0,0" MaxWidth="220"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ProgressDisplay}" Foreground="#9FB4CC"
                                                       FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border.ToolTip>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <h:Icon Kind="sync" Size="16" Foreground="{StaticResource App.Brush.DeepSkyBlue}" VerticalAlignment="Center"/>
                            <StackPanel Margin="10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActiveTransferCountText}"
                                           Foreground="White" FontSize="11"/>
                                <ProgressBar Style="{StaticResource App.Style.ProgressBar}" Width="120" Height="4"
                                             Value="{Binding AggregateProgress}" Minimum="0" Maximum="100"
                                             Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Style="{StaticResource App.Style.Button.IconOnly}"
                                    Command="{Binding CancelAllTransfersCommand}"
                                    ToolTip="{h:Translate FileManager_Tooltip_CancelAll}">
                                <h:Icon Kind="close" Size="14"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </h:ShadowCard>
        </Grid>

        <Border IsHitTestVisible="False" Background="#CC0E1A33"
                Visibility="{Binding IsDragHovering, Converter={StaticResource App.Converter.BooleanToVisibility}}">
            <Grid Margin="60">
                <Border CornerRadius="20" Background="{StaticResource FileManager.Brush.AccentSoft}">
                    <Border.Effect>
                        <DropShadowEffect Color="{StaticResource App.Color.DeepSkyBlue}" BlurRadius="50" ShadowDepth="0" Opacity="0.5"/>
                    </Border.Effect>
                </Border>
                <Border CornerRadius="20"
                        BorderBrush="{StaticResource App.Brush.DeepSkyBlue}" BorderThickness="3">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="100" Height="100" CornerRadius="28"
                                Background="{StaticResource App.Brush.IconCircle}"
                                HorizontalAlignment="Center">
                            <h:Icon Kind="upload" Size="46" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{h:Translate FileManager_DragHover_Title}" Foreground="White"
                                   FontSize="26" FontWeight="Bold" Margin="0,20,0,0"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentPath, StringFormat=→ {0}}" Foreground="#C0D0E4"
                                   FontSize="13" FontFamily="Cascadia Code, Consolas" Margin="0,6,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Background="#C0050C1F"
                Visibility="{Binding IsPromptOpen, Converter={StaticResource App.Converter.BooleanToVisibility}}">
            <Grid Width="460" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border CornerRadius="16" Background="#FF050C1F">
                    <Border.Effect>
                        <StaticResource ResourceKey="FileManager.Effect.ModalGlow"/>
                    </Border.Effect>
                </Border>
                <Border CornerRadius="16" Background="#FF131F3D"
                        BorderBrush="{StaticResource App.Brush.DeepSkyBlue}" BorderThickness="1.5">
                    <StackPanel Margin="28,24,28,24">
                        <TextBlock Text="{Binding PromptTitle}" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="{Binding PromptLabel}" Foreground="#8FA0BC" FontSize="12"
                                   Margin="0,6,0,12" TextWrapping="Wrap"/>
                        <TextBox x:Name="PromptInput"
                                 Style="{StaticResource App.Style.TextBox.Glass}"
                                 Height="42" Padding="14,0"
                                 FontFamily="Cascadia Code, Consolas" FontSize="14"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding PromptValue, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnPromptKeyDown"/>
                        <TextBlock Text="{Binding PromptError}" Foreground="#FFA1A1" FontSize="12"
                                   Margin="0,8,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasPromptError, Converter={StaticResource App.Converter.BooleanToVisibility}}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                            <Button Style="{StaticResource App.Style.Button.Inline}"
                                    Content="{h:Translate Common_Button_Cancel}"
                                    Command="{Binding CancelPromptCommand}"
                                    MinWidth="100"/>
                            <Button Style="{StaticResource App.Style.Button}"
                                    Content="{h:Translate Common_Button_OK}"
                                    Command="{Binding ConfirmPromptCommand}"
                                    MinWidth="100" Margin="8,0,0,0"
                                    IsDefault="True"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
